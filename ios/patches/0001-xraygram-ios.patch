@@ -0,0 +1,139 @@
+import Foundation
+import UIKit
+import CoreImage
+import UniformTypeIdentifiers
+import XraygramKit
+
+// Xraygram: окно «Поделиться сервером» (FEAT-15, этап 1). QR со ссылкой XRAY-записи (ровно та, что хранится,
+// с #именем), саму ссылку текстом не показываем. «Копировать ссылку» — только в буфер этого устройства
+// (localOnly: без Universal Clipboard), «Отправить…» — системное меню. Ссылку никуда не логируем.
+// Нативный UIKit-контроллер: показывается через Window1.presentNative.
+
+final class XraygramShareServerController: UIViewController {
+    private let link: String
+    private let titleText: String
+    private let strings: XrayStrings
+    private var copyButton: UIButton?
+
+    init(link: String, title: String, strings: XrayStrings) {
+        self.link = link
+        self.titleText = title
+        self.strings = strings
+        super.init(nibName: nil, bundle: nil)
+        self.modalPresentationStyle = .pageSheet
+        if let sheet = self.sheetPresentationController {
+            sheet.prefersGrabberVisible = true
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    private static func qrImage(for text: String, side: CGFloat) -> UIImage? {
+        guard let filter = CIFilter(name: "CIQRCodeGenerator") else {
+            return nil
+        }
+        filter.setValue(Data(text.utf8), forKey: "inputMessage")
+        filter.setValue("M", forKey: "inputCorrectionLevel")
+        guard let output = filter.outputImage else {
+            return nil
+        }
+        let scale = max(1.0, floor(side / output.extent.width))
+        let scaled = output.transformed(by: CGAffineTransform(scaleX: scale, y: scale))
+        guard let cgImage = CIContext(options: nil).createCGImage(scaled, from: scaled.extent) else {
+            return nil
+        }
+        return UIImage(cgImage: cgImage)
+    }
+
+    private func makeButton(_ title: String, filled: Bool, action: Selector) -> UIButton {
+        let button = UIButton(type: .system)
+        var configuration: UIButton.Configuration = filled ? .filled() : .tinted()
+        configuration.title = title
+        configuration.cornerStyle = .capsule
+        configuration.buttonSize = .large
+        button.configuration = configuration
+        button.addTarget(self, action: action, for: .touchUpInside)
+        return button
+    }
