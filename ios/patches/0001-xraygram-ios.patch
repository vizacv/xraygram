+++ b/submodules/SettingsUI/Sources/Data and Storage/XraygramGateController.swift	
@@ -0,0 +1,321 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import AlertUI
+import XraygramKit
+
+// Xraygram: экран «Подключение через XRAY». Показывается (AppDelegate), пока нет ни одной
+// XRAY-записи и не выбрано «напрямую» (ProxySettings.xraygramNetworkBlocked); сеть в это время
+// заблокирована («чёрная дыра» в effectiveActiveServer). Правила — macos/decisions.md, «Экран XRAY».
+// Строки только по-русски, как и остальные строки Xraygram.
+
+private final class XraygramGateArguments {
+    let updateState: ((XraygramGateState) -> XraygramGateState) -> Void
+    let pasteLink: (String) -> Void
+    let connect: () -> Void
+    let connectDirect: () -> Void
+    let dismissInput: () -> Void
+
+    init(updateState: @escaping ((XraygramGateState) -> XraygramGateState) -> Void, pasteLink: @escaping (String) -> Void, connect: @escaping () -> Void, connectDirect: @escaping () -> Void, dismissInput: @escaping () -> Void) {
+        self.updateState = updateState
+        self.pasteLink = pasteLink
+        self.connect = connect
+        self.connectDirect = connectDirect
+        self.dismissInput = dismissInput
+    }
+}
+
+private enum XraygramGateSection: Int32 {
+    case intro
+    case saved
+    case link
+    case connect
+    case direct
+}
+
+private enum XraygramGateSelection: Equatable {
+    case saved(String)
+    case new
+}
+
+private struct XraygramGateState: Equatable {
+    /// nil — ещё не выбирали: первая сохранённая ссылка, если есть, иначе «Новая ссылка».
+    var selection: XraygramGateSelection?
+    var link: String
+
+    func resolvedSelection(savedLinks: [String]) -> XraygramGateSelection {
+        if let selection = self.selection {
+            if case let .saved(link) = selection, !savedLinks.contains(link) {
+                return .new
+            }
+            return selection
+        }
+        if let first = savedLinks.first {
+            return .saved(first)
+        }
+        return .new
+    }
+
+    func linkToConnect(savedLinks: [String]) -> String {
+        switch self.resolvedSelection(savedLinks: savedLinks) {
+        case let .saved(link):
+            return link
+        case .new:
+            return self.link.trimmingCharacters(in: .whitespacesAndNewlines)
+        }
+    }
+}
+
+private enum XraygramGateEntry: ItemListNodeEntry {
+    case intro(String)
+    case savedHeader(String)
+    case saved(Int32, String, String, Bool)
+    case newLink(String, Bool)
+    case linkHeader(String)
+    case paste(String)
+    case link(String, String)
+    case linkInfo(String)
+    case connect(String, Bool)
+    case direct(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .intro:
+            return XraygramGateSection.intro.rawValue
+        case .savedHeader, .saved, .newLink:
+            return XraygramGateSection.saved.rawValue
+        case .linkHeader, .paste, .link, .linkInfo:
+            return XraygramGateSection.link.rawValue
+        case .connect:
+            return XraygramGateSection.connect.rawValue
+        case .direct:
+            return XraygramGateSection.direct.rawValue
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .intro:
+            return 0
+        case .savedHeader:
+            return 1
+        case let .saved(index, _, _, _):
+            return 100 + index
+        case .newLink:
+            return 10000
+        case .linkHeader:
+            return 10001
+        case .paste:
+            return 10002
+        case .link:
+            return 10003
+        case .linkInfo:
+            return 10004
+        case .connect:
+            return 10005
+        case .direct:
+            return 10006
+        }
+    }
+
+    static func <(lhs: XraygramGateEntry, rhs: XraygramGateEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! XraygramGateArguments
+        switch self {
+        case let .intro(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .savedHeader(text), let .linkHeader(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .saved(_, link, title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: checked, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.updateState { state in
+                    var state = state
+                    state.selection = .saved(link)
+                    return state
+                }
+            })
+        case let .newLink(title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: checked, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.updateState { state in
+                    var state = state
+                    state.selection = .new
+                    return state
+                }
+            })
+        case let .paste(title):
+            // Системная кнопка «Вставить» (UIPasteControl): вставка без запроса разрешения (BUG-14).
+            return XraygramPasteItem(presentationData: presentationData, fallbackTitle: title, sectionId: self.section, pasted: { text in
+                arguments.pasteLink(text)
+            })
+        case let .link(placeholder, text):
+            return ItemListMultilineInputItem(presentationData: presentationData, systemStyle: .glass, text: text, placeholder: placeholder, maxLength: nil, sectionId: self.section, style: .blocks, capitalization: false, autocorrection: false, returnKeyType: .done, minimalHeight: nil, textUpdated: { value in
+                arguments.updateState { state in
+                    var state = state
+                    state.link = value
+                    return state
+                }
+            }, shouldUpdateText: { value in
+                return !value.contains("\n")
+            }, action: {
+                arguments.dismissInput()
+            })
+        case let .linkInfo(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .connect(title, enabled):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: enabled ? .generic : .disabled, alignment: .center, sectionId: self.section, style: .blocks, action: {
+                arguments.connect()
+            })
+        case let .direct(title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .neutral, alignment: .center, sectionId: self.section, style: .blocks, action: {
+                arguments.connectDirect()
+            })
+        }
+    }
+}
+
+private func xraygramGateEntries(state: XraygramGateState, savedLinks: [String], xs: XrayStrings) -> [XraygramGateEntry] {
+    var entries: [XraygramGateEntry] = []
+    // Тексты — product/features/FEAT-03.md.
+    if savedLinks.isEmpty {
+        entries.append(.intro(xs.gateTextNoSaved))
+    } else {
+        entries.append(.intro(xs.gateTextSaved))
+    }
+
+    let selection = state.resolvedSelection(savedLinks: savedLinks)
+    if !savedLinks.isEmpty {
+        entries.append(.savedHeader(xs.savedServers))
+        for (index, link) in savedLinks.enumerated() {
+            entries.append(.saved(Int32(index), link, XrayLink.displayTitle(link), selection == .saved(link)))
+        }
+        entries.append(.newLink(xs.newLink, selection == .new))
+    }
+
+    var canConnect = false
+    if selection == .new {
+        entries.append(.linkHeader(xs.linkHeader))
+        entries.append(.paste(xs.pasteButton))
+        entries.append(.link("vless://…", state.link))
+        let trimmed = state.link.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.isEmpty {
+            entries.append(.linkInfo(xs.linkHint))
+        } else {
+            switch XrayLink.check(trimmed) {
+            case let .success(info):
+                entries.append(.linkInfo(xs.serverPreview(info)))
+                canConnect = true
+            case let .failure(error):
+                entries.append(.linkInfo(xs.errorPreview(error)))
+            }
+        }
+    } else if case let .saved(link) = selection, case .success = XrayLink.check(link) {
+        canConnect = true
+    }
+
+    entries.append(.connect(xs.connect, canConnect))
+    entries.append(.direct(xs.connectDirectLink))
+    return entries
+}
+
+/// Xraygram: экран «Подключение через XRAY». Сам не закрывается: его убирает AppDelegate, когда
+/// блокировка снята (появилась XRAY-запись или выбрано «напрямую»).
+public func xraygramGateController(sharedContext: SharedAccountContext, accountManager: AccountManager<TelegramAccountManagerTypes>, didDisappear: @escaping () -> Void) -> ViewController {
+    let presentationData = sharedContext.currentPresentationData.with { $0 }
+
+    let initialState = XraygramGateState(selection: nil, link: "")
+    let stateValue = Atomic(value: initialState)
+    let statePromise = ValuePromise(initialState, ignoreRepeated: true)
+    let updateState: ((XraygramGateState) -> XraygramGateState) -> Void = { f in
+        statePromise.set(stateValue.modify { f($0) })
+    }
+
+    let savedLinksValue = Atomic<[String]>(value: [])
+    let savedLinks: Signal<[String], NoError> = accountManager.sharedData(keys: [SharedDataKeys.proxySettings])
+    |> map { sharedData -> [String] in
+        return (sharedData.entries[SharedDataKeys.proxySettings]?.get(ProxySettings.self) ?? ProxySettings.defaultSettings).xraygramSavedLinks
+    }
+    |> distinctUntilChanged
+
+    var presentControllerImpl: ((ViewController) -> Void)?
+    var dismissInputImpl: (() -> Void)?
+
+    let arguments = XraygramGateArguments(updateState: updateState, pasteLink: { text in
+        let link = XrayLink.extract(from: text) ?? text.trimmingCharacters(in: .whitespacesAndNewlines)
+        if !link.isEmpty {
+            updateState { state in
+                var state = state
+                state.selection = .new
+                state.link = link
+                return state
+            }
+        }
+    }, connect: {
+        dismissInputImpl?()
+        let link = stateValue.with { $0 }.linkToConnect(savedLinks: savedLinksValue.with { $0 })
+        guard case let .success(info) = XrayLink.check(link) else {
+            return
+        }
+        let server = ProxyServerSettings(host: info.address, port: Int32(clamping: info.port), connection: .xray(link: link))
+        let _ = updateProxySettingsInteractively(accountManager: accountManager, { settings in
+            var settings = settings
+            if let existing = settings.servers.first(where: { $0.xrayLink == link }) {
+                settings.activeServer = existing
+            } else {
+                settings.servers.append(server)
+                settings.activeServer = server
+            }
+            settings.enabled = true
+            return settings
+        }).start()
+    }, connectDirect: {
+        dismissInputImpl?()
+        let xs = xraygramStrings(sharedContext.currentPresentationData.with { $0 })
+        presentControllerImpl?(textAlertController(sharedContext: sharedContext, title: xs.directTitle, text: xs.directText, actions: [
+            TextAlertAction(type: .genericAction, title: xs.cancel, action: {}),
+            TextAlertAction(type: .destructiveAction, title: xs.connectDirect, action: {
+                let _ = updateProxySettingsInteractively(accountManager: accountManager, { settings in
+                    var settings = settings
+                    settings.xraygramDirectAllowed = true
+                    return settings
+                }).start()
+            })
+        ]))
+    }, dismissInput: {
+        dismissInputImpl?()
+    })
+
+    let signal = combineLatest(sharedContext.presentationData, statePromise.get(), savedLinks)
+    |> deliverOnMainQueue
+    |> map { presentationData, state, savedLinks -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let _ = savedLinksValue.swap(savedLinks)
+        var presentationData = presentationData
+        presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+
+        let xs = xraygramStrings(presentationData)
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(xs.gateTitle), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: nil, animateChanges: false)
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: xraygramGateEntries(state: state, savedLinks: savedLinks, xs: xs), style: .blocks, emptyStateItem: nil, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(presentationData: ItemListPresentationData(presentationData), updatedPresentationData: sharedContext.presentationData |> map(ItemListPresentationData.init(_:)), state: signal, tabBarItem: nil)
+    controller.navigationPresentation = .modal
+    controller.didDisappear = { _ in
+        didDisappear()
+    }
+    presentControllerImpl = { [weak controller] c in
+        controller?.present(c, in: .window(.root))
+    }
+    dismissInputImpl = { [weak controller] in
+        controller?.view.endEditing(true)
+    }
+    return controller
+}
diff --git a/submodules/SettingsUI/Sources/Data and Storage/XraygramPasteItem.swift b/submodules/SettingsUI/Sources/Data and Storage/XraygramPasteItem.swift
new file mode 100644
index 00000000..38d6f9da
--- /dev/null
+++ b/submodules/SettingsUI/Sources/Data and Storage/XraygramPasteItem.swift	
@@ -0,0 +1,237 @@
+import Foundation
+import UIKit
+import UniformTypeIdentifiers
+import Display
+import AsyncDisplayKit
+import SwiftSignalKit
+import TelegramPresentationData
+import ItemListUI
+
+// Xraygram: строка со стандартной кнопкой «Вставить» (UIPasteControl, iOS 16+). Чтение буфера по
+// своей кнопке на iOS 16+ требует системного подтверждения, а на iOS 27 (по крайней мере в симуляторе)
+// оно молча отклоняется (BUG-14). Системная кнопка вставки даёт доступ без запроса. Подпись у неё
+// системная («Вставить» / «Paste»), свою задать нельзя. На iOS 15 — обычная кнопка с чтением буфера.
+
+final class XraygramPasteItem: ListViewItem, ItemListItem {
+    let presentationData: ItemListPresentationData
+    let systemStyle: ItemListSystemStyle
+    let fallbackTitle: String
+    let sectionId: ItemListSectionId
+    let pasted: (String) -> Void
+
+    init(presentationData: ItemListPresentationData, systemStyle: ItemListSystemStyle = .glass, fallbackTitle: String, sectionId: ItemListSectionId, pasted: @escaping (String) -> Void) {
+        self.presentationData = presentationData
+        self.systemStyle = systemStyle
+        self.fallbackTitle = fallbackTitle
+        self.sectionId = sectionId
+        self.pasted = pasted
+    }
+
+    func nodeConfiguredForParams(async: @escaping (@escaping () -> Void) -> Void, params: ListViewItemLayoutParams, synchronousLoads: Bool, neighbors: ListViewItemNeighbors, completion: @escaping (ListViewItemNode, @escaping () -> (Signal<Void, NoError>?, (ListViewItemApply) -> Void)) -> Void) {
+        async {
+            let node = XraygramPasteItemNode()
+            let (layout, apply) = node.asyncLayout()(self, params, itemListNeighbors(item: self, topFacet: neighbors.previous?.base(ItemListNeighborFacet.self), bottomFacet: neighbors.next?.base(ItemListNeighborFacet.self)))
+            node.contentSize = layout.contentSize
+            node.insets = layout.insets
+            Queue.mainQueue().async {
+                completion(node, {
+                    return (nil, { _ in apply() })
+                })
+            }
+        }
+    }
+
+    func updateNode(async: @escaping (@escaping () -> Void) -> Void, node: @escaping () -> ListViewItemNode, params: ListViewItemLayoutParams, neighbors: ListViewItemNeighbors, animation: ListViewItemUpdateAnimation, completion: @escaping (ListViewItemNodeLayout, @escaping (ListViewItemApply) -> Void) -> Void) {
+        Queue.mainQueue().async {
+            if let nodeValue = node() as? XraygramPasteItemNode {
+                let makeLayout = nodeValue.asyncLayout()
+                async {
+                    let (layout, apply) = makeLayout(self, params, itemListNeighbors(item: self, topFacet: neighbors.previous?.base(ItemListNeighborFacet.self), bottomFacet: neighbors.next?.base(ItemListNeighborFacet.self)))
+                    Queue.mainQueue().async {
+                        completion(layout, { _ in
+                            apply()
+                        })
+                    }
+                }
+            }
+        }
+    }
+
+    let selectable = false
+}
+
+/// Получатель вставки для UIPasteControl: принимает текст и отдаёт его наверх.
+private final class XraygramPasteTarget: UIResponder {
+    var pasted: ((String) -> Void)?
+
+    override init() {
+        super.init()
+        if #available(iOS 16.0, *) {
+            self.pasteConfiguration = UIPasteConfiguration(acceptableTypeIdentifiers: [UTType.plainText.identifier, UTType.utf8PlainText.identifier, UTType.url.identifier])
+        }
+    }
+
+    override func canPaste(_ itemProviders: [NSItemProvider]) -> Bool {
+        return true
+    }
+
+    override func paste(itemProviders: [NSItemProvider]) {
+        guard let provider = itemProviders.first(where: { $0.canLoadObject(ofClass: NSString.self) }) else {
+            return
+        }
+        let _ = provider.loadObject(ofClass: NSString.self, completionHandler: { [weak self] value, _ in
+            guard let text = value as? String else {
+                return
+            }
+            DispatchQueue.main.async {
+                self?.pasted?(text)
+            }
+        })
+    }
+}
+
+final class XraygramPasteItemNode: ListViewItemNode, ItemListItemNode {
+    private let backgroundNode: ASDisplayNode
+    private let topStripeNode: ASDisplayNode
+    private let bottomStripeNode: ASDisplayNode
+    private let maskNode: ASImageNode
+
+    private let pasteTarget = XraygramPasteTarget()
+    private var pasteControl: UIView?
+    private var item: XraygramPasteItem?
+
+    override var canBeSelected: Bool {
+        return false
+    }
+
+    var tag: ItemListItemTag? {
+        return nil
+    }
+
+    init() {
+        self.backgroundNode = ASDisplayNode()
+        self.backgroundNode.isLayerBacked = true
+        self.maskNode = ASImageNode()
+        self.maskNode.isUserInteractionEnabled = false
+        self.topStripeNode = ASDisplayNode()
+        self.topStripeNode.isLayerBacked = true
+        self.bottomStripeNode = ASDisplayNode()
+        self.bottomStripeNode.isLayerBacked = true
+
+        super.init(layerBacked: false)
+
+        self.pasteTarget.pasted = { [weak self] text in
+            self?.item?.pasted(text)
+        }
+    }
+
+    @objc private func fallbackPressed() {
+        if let text = UIPasteboard.general.string {
+            self.item?.pasted(text)
+        }
+    }
+
+    private func makePasteControl(theme: PresentationTheme, fallbackTitle: String) -> UIView {
+        if #available(iOS 16.0, *) {
+            let configuration = UIPasteControl.Configuration()
+            configuration.displayMode = .iconAndLabel
+            configuration.cornerStyle = .capsule
+            configuration.baseBackgroundColor = theme.list.itemAccentColor
+            configuration.baseForegroundColor = .white
+            let control = UIPasteControl(configuration: configuration)
+            control.target = self.pasteTarget
+            return control
+        } else {
+            let button = UIButton(type: .system)
+            button.setTitle(fallbackTitle, for: .normal)
+            button.setTitleColor(theme.list.itemAccentColor, for: .normal)
+            button.addTarget(self, action: #selector(self.fallbackPressed), for: .touchUpInside)
+            return button
+        }
+    }
+
+    func asyncLayout() -> (_ item: XraygramPasteItem, _ params: ListViewItemLayoutParams, _ neighbors: ItemListNeighbors) -> (ListViewItemNodeLayout, () -> Void) {
+        let currentItem = self.item
+        return { [weak self] item, params, neighbors in
+            let updatedTheme = currentItem?.presentationData.theme !== item.presentationData.theme
+            let separatorHeight = UIScreenPixel
+            let height: CGFloat = 60.0
+            let contentSize = CGSize(width: params.width, height: height)
+            let insets = itemListNeighborsGroupedInsets(neighbors, params)
+            let theme = item.presentationData.theme
+
+            return (ListViewItemNodeLayout(contentSize: contentSize, insets: insets), { [weak self] in
+                guard let self else {
+                    return
+                }
+                self.item = item
+
+                if updatedTheme || self.backgroundNode.supernode == nil {
+                    self.topStripeNode.backgroundColor = theme.list.itemBlocksSeparatorColor
+                    self.bottomStripeNode.backgroundColor = theme.list.itemBlocksSeparatorColor
+                    self.backgroundNode.backgroundColor = theme.list.itemBlocksBackgroundColor
+                }
+                if self.backgroundNode.supernode == nil {
+                    self.insertSubnode(self.backgroundNode, at: 0)
+                    self.insertSubnode(self.topStripeNode, at: 1)
+                    self.insertSubnode(self.bottomStripeNode, at: 2)
+                    self.insertSubnode(self.maskNode, at: 3)
+                }
+                if updatedTheme, let pasteControl = self.pasteControl {
+                    pasteControl.removeFromSuperview()
+                    self.pasteControl = nil
+                }
+                if self.pasteControl == nil {
+                    let control = self.makePasteControl(theme: theme, fallbackTitle: item.fallbackTitle)
+                    self.view.addSubview(control)
+                    self.pasteControl = control
+                }
+
+                let hasCorners = itemListHasRoundedBlockLayout(params)
+                var hasTopCorners = false
+                var hasBottomCorners = false
+                switch neighbors.top {
+                case .sameSection(false):
+                    self.topStripeNode.isHidden = true
+                default:
+                    hasTopCorners = true
+                    self.topStripeNode.isHidden = hasCorners
+                }
+                let leftInset = 16.0 + params.leftInset
+                let bottomStripeInset: CGFloat
+                switch neighbors.bottom {
+                case .sameSection(false):
+                    bottomStripeInset = leftInset
+                    self.bottomStripeNode.isHidden = false
+                default:
+                    bottomStripeInset = 0.0
+                    hasBottomCorners = true
+                    self.bottomStripeNode.isHidden = hasCorners
+                }
+                self.maskNode.image = hasCorners ? PresentationResourcesItemList.cornersImage(theme, top: hasTopCorners, bottom: hasBottomCorners, glass: item.systemStyle == .glass) : nil
+
+                self.backgroundNode.frame = CGRect(origin: CGPoint(x: 0.0, y: -min(insets.top, separatorHeight)), size: CGSize(width: params.width, height: contentSize.height + min(insets.top, separatorHeight) + min(insets.bottom, separatorHeight)))
+                self.maskNode.frame = self.backgroundNode.frame.inset(by: UIEdgeInsets(top: 0.0, left: params.leftInset, bottom: 0.0, right: params.rightInset))
+                self.topStripeNode.frame = CGRect(origin: CGPoint(x: 0.0, y: -min(insets.top, separatorHeight)), size: CGSize(width: params.width, height: separatorHeight))
+                self.bottomStripeNode.frame = CGRect(origin: CGPoint(x: bottomStripeInset, y: contentSize.height - separatorHeight), size: CGSize(width: params.width - bottomStripeInset, height: separatorHeight))
+
+                if let pasteControl = self.pasteControl {
+                    let size = CGSize(width: 160.0, height: 40.0)
+                    pasteControl.frame = CGRect(origin: CGPoint(x: params.leftInset + floor((params.width - params.leftInset - params.rightInset - size.width) / 2.0), y: floor((height - size.height) / 2.0)), size: size)
+                }
+            })
+        }
+    }
+
+    override func animateInsertion(_ currentTimestamp: Double, duration: Double, options: ListViewItemAnimationOptions) {
+        self.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.4)
+    }
+
+    override func animateAdded(_ currentTimestamp: Double, duration: Double) {
+        self.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.2)
+    }
+
+    override func animateRemoved(_ currentTimestamp: Double, duration: Double) {
+        self.layer.animateAlpha(from: 1.0, to: 0.0, duration: 0.15, removeOnCompletion: false)
+    }
+}
diff --git a/submodules/SettingsUI/Sources/Data and Storage/XraygramShareServerController.swift b/submodules/SettingsUI/Sources/Data and Storage/XraygramShareServerController.swift
