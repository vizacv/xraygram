+
+        let langHeight: CGFloat = 44.0
+        let langY = size.height - bottomInset - langHeight
+        let ruSize = self.ruButton.sizeThatFits(CGSize(width: 200.0, height: langHeight))
+        let enSize = self.enButton.sizeThatFits(CGSize(width: 200.0, height: langHeight))
+        let dotSize = self.dotLabel.sizeThatFits(CGSize(width: 40.0, height: langHeight))
+        let gap: CGFloat = 10.0
+        let totalLang = ruSize.width + gap + dotSize.width + gap + enSize.width
