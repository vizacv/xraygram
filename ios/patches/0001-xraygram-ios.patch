+        let blockY = self.safeAreaInsets.top + max(0.0, floor((available - blockHeight) / 2.0)) - 16.0
+        let iconFrame = CGRect(x: floor((size.width - canvas) / 2.0), y: blockY, width: canvas, height: canvas)
+        self.iconView.frame = iconFrame
+        let titleY = iconFrame.maxY - 32.0 + 8.0
+        self.titleLabel.frame = CGRect(x: 0.0, y: titleY, width: size.width, height: titleSize.height)
+        self.subtitleLabel.frame = CGRect(x: floor((size.width - textWidth) / 2.0), y: self.titleLabel.frame.maxY + 12.0, width: textWidth, height: subtitleSize.height)
+
+        let iconSide: CGFloat = 176.0
+        let iconRect = CGRect(x: iconFrame.midX - iconSide / 2.0, y: iconFrame.midY - iconSide / 2.0, width: iconSide, height: iconSide)
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.beamContainer.frame = iconRect
+        self.beamMask.path = UIBezierPath(roundedRect: CGRect(origin: .zero, size: iconRect.size), cornerRadius: 40.0).cgPath
+        self.beamLayer.frame = CGRect(x: 0.0, y: -48.0, width: iconSide, height: 48.0)
+        self.beamLine.frame = CGRect(x: 0.0, y: 23.5, width: iconSide, height: 1.0)
+        CATransaction.commit()
+    }
+
+    // Продолжение заставки: иконка из центра экрана (где она была на LaunchScreen) едет на место, текст проявляется.
+    func animateIn() {
+        self.layoutIfNeeded()
+        let target = self.iconView.center
+        let start = CGPoint(x: self.bounds.midX, y: self.bounds.midY)
+        self.iconView.layer.animatePosition(from: start, to: target, duration: 0.5, timingFunction: kCAMediaTimingFunctionSpring)
+        self.beamContainer.animatePosition(from: CGPoint(x: start.x, y: start.y), to: self.beamContainer.position, duration: 0.5, timingFunction: kCAMediaTimingFunctionSpring)
+        for view in [self.titleLabel, self.subtitleLabel, self.startButton, self.ruButton, self.enButton, self.dotLabel] as [UIView] {
+            view.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.4)
+        }
+    }
+
+    func playBeamIfNeeded() {
+        if self.didPlayBeam || UIAccessibility.isReduceMotionEnabled || self.bounds.isEmpty {
+            return
+        }
+        self.didPlayBeam = true
+        self.layoutIfNeeded()
+        let height = self.beamContainer.bounds.height
+        let beamHeight = self.beamLayer.bounds.height
+        self.beamContainer.isHidden = false
+        let animation = CABasicAnimation(keyPath: "position.y")
+        animation.fromValue = -beamHeight / 2.0
+        animation.toValue = height + beamHeight / 2.0
+        animation.duration = 1.2
+        animation.timingFunction = CAMediaTimingFunction(name: .easeInEaseOut)
+        animation.fillMode = .forwards
+        animation.isRemovedOnCompletion = false
+        CATransaction.begin()
+        CATransaction.setCompletionBlock { [weak self] in
+            self?.beamContainer.isHidden = true
+        }
+        self.beamLayer.add(animation, forKey: "beam")
+        CATransaction.commit()
+    }
