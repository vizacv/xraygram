+        let subtitleSize = self.subtitleLabel.sizeThatFits(CGSize(width: textWidth, height: 200.0))
+        let titleSize = self.titleLabel.sizeThatFits(CGSize(width: size.width, height: 60.0))
+        let blockHeight = canvas - 32.0 + 8.0 + titleSize.height + 12.0 + subtitleSize.height
