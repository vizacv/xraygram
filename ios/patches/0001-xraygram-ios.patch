+++ b/submodules/XraygramKit/BUILD
@@ -0,0 +1,21 @@
+load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
+
+# Xraygram: обёртка над XraygramCore (xray внутри процесса, локальный SOCKS5 с паролем).
+# Исходники — ios/xraykit/swift/XraygramKit в репозитории Xraygram; сюда их копирует
+# ios/scripts/build.sh (prepare). Только Foundation, без UIKit: годится и для macOS-клиента.
+swift_library(
+    name = "XraygramKit",
+    module_name = "XraygramKit",
+    srcs = glob([
+        "Sources/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    deps = [
+        "//third-party/XraygramCore:XraygramCore",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
diff --git a/third-party/XraygramCore/BUILD b/third-party/XraygramCore/BUILD
new file mode 100644
index 00000000..7e9e3378
--- /dev/null
+++ b/third-party/XraygramCore/BUILD
@@ -0,0 +1,22 @@
+load(
+    "@build_bazel_rules_apple//apple:apple.bzl",
+    "apple_static_xcframework_import",
+)
+
+# Xraygram: Xray-core + libXray `share` как Go c-archive (ios/xraykit/go в репозитории Xraygram).
+# XraygramCore.xcframework кладёт сюда ios/scripts/build.sh (prepare); в патч он не входит.
+# В процессе может быть только один Go-рантайм: линкуем ровно в одно место (TelegramCore через XraygramKit).
+apple_static_xcframework_import(
+    name = "XraygramCore",
+    xcframework_imports = glob(["XraygramCore.xcframework/**"]),
+    linkopts = [
+        "-lresolv",
+    ],
+    sdk_frameworks = [
+        "CoreFoundation",
+        "Security",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
