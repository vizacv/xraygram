@@ -0,0 +1,139 @@
+import Foundation
+import UIKit
+import CoreImage
+import UniformTypeIdentifiers
+import XraygramKit
+
+// Xraygram: окно «Поделиться сервером» (FEAT-15, этап 1). QR со ссылкой XRAY-записи (ровно та, что хранится,
+// с #именем), саму ссылку текстом не показываем. «Копировать ссылку» — только в буфер этого устройства
+// (localOnly: без Universal Clipboard), «Отправить…» — системное меню. Ссылку никуда не логируем.
+// Нативный UIKit-контроллер: показывается через Window1.presentNative.
+
+final class XraygramShareServerController: UIViewController {
+    private let link: String
+    private let titleText: String
+    private let strings: XrayStrings
+    private var copyButton: UIButton?
+
+    init(link: String, title: String, strings: XrayStrings) {
+        self.link = link
+        self.titleText = title
+        self.strings = strings
+        super.init(nibName: nil, bundle: nil)
+        self.modalPresentationStyle = .pageSheet
+        if let sheet = self.sheetPresentationController {
+            sheet.prefersGrabberVisible = true
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    private static func qrImage(for text: String, side: CGFloat) -> UIImage? {
+        guard let filter = CIFilter(name: "CIQRCodeGenerator") else {
+            return nil
+        }
+        filter.setValue(Data(text.utf8), forKey: "inputMessage")
+        filter.setValue("M", forKey: "inputCorrectionLevel")
+        guard let output = filter.outputImage else {
+            return nil
+        }
+        let scale = max(1.0, floor(side / output.extent.width))
+        let scaled = output.transformed(by: CGAffineTransform(scaleX: scale, y: scale))
+        guard let cgImage = CIContext(options: nil).createCGImage(scaled, from: scaled.extent) else {
+            return nil
+        }
+        return UIImage(cgImage: cgImage)
+    }
+
+    private func makeButton(_ title: String, filled: Bool, action: Selector) -> UIButton {
+        let button = UIButton(type: .system)
+        var configuration: UIButton.Configuration = filled ? .filled() : .tinted()
+        configuration.title = title
+        configuration.cornerStyle = .capsule
+        configuration.buttonSize = .large
+        button.configuration = configuration
+        button.addTarget(self, action: action, for: .touchUpInside)
+        return button
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .systemBackground
+
+        let titleLabel = UILabel()
+        titleLabel.text = self.titleText
+        titleLabel.font = UIFont.systemFont(ofSize: 20.0, weight: .semibold)
+        titleLabel.textAlignment = .center
+        titleLabel.numberOfLines = 2
+
+        let qrSide: CGFloat = 260.0
+        let qrView = UIImageView(image: XraygramShareServerController.qrImage(for: self.link, side: qrSide))
+        qrView.contentMode = .scaleAspectFit
+        qrView.layer.magnificationFilter = .nearest
+        qrView.backgroundColor = .white
+        qrView.layer.cornerRadius = 12.0
+        qrView.clipsToBounds = true
+        qrView.translatesAutoresizingMaskIntoConstraints = false
+        qrView.accessibilityLabel = "QR"
+        NSLayoutConstraint.activate([
+            qrView.widthAnchor.constraint(equalToConstant: qrSide + 24.0),
+            qrView.heightAnchor.constraint(equalToConstant: qrSide + 24.0)
+        ])
+
+        let captionLabel = UILabel()
+        captionLabel.text = self.strings.shareCaption
+        captionLabel.font = UIFont.systemFont(ofSize: 15.0)
+        captionLabel.textColor = .secondaryLabel
+        captionLabel.textAlignment = .center
+        captionLabel.numberOfLines = 0
+
+        let copyButton = self.makeButton(self.strings.copyLink, filled: true, action: #selector(self.copyPressed))
+        self.copyButton = copyButton
+        let sendButton = self.makeButton(self.strings.send, filled: false, action: #selector(self.sendPressed))
+        let closeButton = self.makeButton(self.strings.close, filled: false, action: #selector(self.closePressed))
+
+        let stack = UIStackView(arrangedSubviews: [titleLabel, qrView, captionLabel, copyButton, sendButton, closeButton])
+        stack.axis = .vertical
+        stack.alignment = .center
+        stack.spacing = 16.0
+        stack.setCustomSpacing(24.0, after: captionLabel)
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        self.view.addSubview(stack)
+        for button in [copyButton, sendButton, closeButton] {
+            button.widthAnchor.constraint(equalTo: stack.widthAnchor).isActive = true
+        }
+        NSLayoutConstraint.activate([
+            stack.topAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.topAnchor, constant: 32.0),
+            stack.leadingAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.leadingAnchor, constant: 24.0),
+            stack.trailingAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.trailingAnchor, constant: -24.0)
+        ])
+    }
+
+    @objc private func copyPressed() {
+        // Только это устройство: без Universal Clipboard (F15-04).
+        UIPasteboard.general.setItems([[UTType.utf8PlainText.identifier: self.link]], options: [.localOnly: true])
+        guard let copyButton = self.copyButton else {
+            return
+        }
+        let original = self.strings.copyLink
+        copyButton.configuration?.title = self.strings.linkCopied
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) { [weak copyButton] in
+            copyButton?.configuration?.title = original
+        }
+    }
+
+    @objc private func sendPressed() {
+        let activity = UIActivityViewController(activityItems: [self.link], applicationActivities: nil)
+        if let popover = activity.popoverPresentationController {
+            popover.sourceView = self.view
+            popover.sourceRect = CGRect(x: self.view.bounds.midX, y: self.view.bounds.midY, width: 1.0, height: 1.0)
+        }
+        self.present(activity, animated: true)
+    }
+
+    @objc private func closePressed() {
+        self.dismiss(animated: true)
+    }
+}
