+///   (upstream в этом случае выключал прокси, т.е. молча уходил напрямую).
+/// Xraygram: сколько сохранённых XRAY-ссылок держим (FEAT-03 п. 12).
+let xraygramSavedLinksLimit = 20
+
+func xraygramNormalizeProxySettings(previous: ProxySettings, updated: ProxySettings) -> ProxySettings {
+    var result = updated
+    var savedLinks = result.xraygramSavedLinks
+    for server in result.servers {
+        guard let link = server.xrayLink else {
+            continue
+        }
+        if !previous.servers.contains(server) {
+            // Новая (или снова добавленная) ссылка — наверх, дубль схлопывается (FEAT-03 п. 12, F03-15).
+            result.xraygramDirectAllowed = false
+            savedLinks.removeAll(where: { $0 == link })
+            savedLinks.insert(link, at: 0)
+        } else if !savedLinks.contains(link) {
+            // Запись была до появления списка сохранённых — в конец.
+            savedLinks.append(link)
+        }
+    }
+    var seen = Set<String>()
+    savedLinks = savedLinks.filter { seen.insert($0).inserted }
+    if savedLinks.count > xraygramSavedLinksLimit {
+        savedLinks = Array(savedLinks.prefix(xraygramSavedLinksLimit))
+    }
+    result.xraygramSavedLinks = savedLinks
+    if let previousActive = previous.activeServer, previousActive.xrayLink != nil, previous.enabled {
+        let activeStillThere = result.activeServer.flatMap { result.servers.contains($0) ? $0 : nil } != nil
+        if !activeStillThere, let replacement = result.servers.first(where: { $0.xrayLink != nil }) {
+            result.activeServer = replacement
+            result.enabled = true
+        }
+    }
+    return result
+}
