+class ProxyPasswordString : public rtc::CryptStringImpl {
+public:
+    explicit ProxyPasswordString(std::string value) : _value(std::move(value)) {
+    }
+
+    size_t GetLength() const override {
+        return _value.size();
+    }
+
+    void CopyTo(char *dest, bool nullterminate) const override {
+        memcpy(dest, _value.data(), _value.size());
+        if (nullterminate) {
+            dest[_value.size()] = 0;
+        }
+    }
+
+    std::string UrlEncode() const override {
+        return _value;
+    }
+
+    rtc::CryptStringImpl *Copy() const override {
+        return new ProxyPasswordString(_value);
+    }
+
+    void CopyRawTo(std::vector<unsigned char> *dest) const override {
+        dest->assign(_value.begin(), _value.end());
+    }
+
+private:
+    std::string _value;
+};
+
+} // namespace
+
+rtc::ProxyInfo MakeSocks5ProxyInfo(const Proxy &proxy) {
+    rtc::ProxyInfo result;
+    result.type = rtc::ProxyType::PROXY_SOCKS5;
+    result.address = rtc::SocketAddress(proxy.host, proxy.port);
+    result.username = proxy.login;
+    result.password = rtc::CryptString(ProxyPasswordString(proxy.password));
+    return result;
+}
+
+uint32_t ProxiedPortAllocatorFlags(uint32_t flags) {
+    return flags
+        | cricket::PORTALLOCATOR_DISABLE_UDP
+        | cricket::PORTALLOCATOR_DISABLE_STUN
+        | cricket::PORTALLOCATOR_DISABLE_TCP
+        | cricket::PORTALLOCATOR_DISABLE_UDP_RELAY
+        | cricket::PORTALLOCATOR_DISABLE_ADAPTER_ENUMERATION;
+}
