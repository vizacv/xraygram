+// SOCKS5 client (RFC 1928, username/password auth RFC 1929) in front of a
+// TCP socket. libwebrtc dropped AsyncSocksProxySocket, so reflector TCP
+// connections need their own adapter to honour PortAllocator::set_proxy().
+class Socks5ProxySocket : public rtc::BufferedReadAdapter {
+public:
+    Socks5ProxySocket(
+        rtc::Socket *socket,
+        const rtc::SocketAddress &proxy,
+        std::string username,
+        std::string password) :
+    BufferedReadAdapter(socket, 1024),
+    proxy_(proxy),
+    username_(std::move(username)),
+    password_(std::move(password)) {
+    }
+
+    int Connect(const rtc::SocketAddress &address) override {
+        dest_ = address;
+        state_ = State::Init;
+        BufferInput(true);
+        return BufferedReadAdapter::Connect(proxy_);
+    }
+
+    rtc::SocketAddress GetRemoteAddress() const override {
+        return dest_;
+    }
+
+    int Close() override {
+        state_ = State::Init;
+        BufferInput(false);
+        return BufferedReadAdapter::Close();
+    }
+
+    ConnState GetState() const override {
+        if (state_ == State::Tunnel) {
+            return CS_CONNECTED;
+        } else if (state_ == State::Error) {
+            return CS_CLOSED;
+        }
+        return CS_CONNECTING;
+    }
+
+protected:
+    void OnConnectEvent(rtc::Socket *socket) override {
+        sendHello();
+    }
+
+    void ProcessInput(char *data, size_t *len) override {
+        rtc::ByteBufferReader response(rtc::MakeArrayView(
+            reinterpret_cast<const uint8_t*>(data),
+            *len));
+        if (state_ == State::Hello) {
+            uint8_t version = 0;
+            uint8_t method = 0;
+            if (!response.ReadUInt8(&version) || !response.ReadUInt8(&method)) {
+                return;
+            }
+            if (version != 5) {
+                fail(0);
+                return;
+            }
+            if (method == 0) {
+                sendConnect();
+            } else if (method == 2 && !username_.empty()) {
+                sendAuth();
+            } else {
+                fail(0);
+                return;
+            }
+        } else if (state_ == State::Auth) {
+            uint8_t version = 0;
+            uint8_t status = 0;
+            if (!response.ReadUInt8(&version) || !response.ReadUInt8(&status)) {
+                return;
+            }
+            if (version != 1 || status != 0) {
+                fail(SOCKET_EACCES);
+                return;
+            }
+            sendConnect();
+        } else if (state_ == State::Connect) {
+            uint8_t version = 0;
+            uint8_t reply = 0;
+            uint8_t reserved = 0;
+            uint8_t addressType = 0;
+            if (!response.ReadUInt8(&version)
+                || !response.ReadUInt8(&reply)
+                || !response.ReadUInt8(&reserved)
+                || !response.ReadUInt8(&addressType)) {
+                return;
+            }
+            if (version != 5 || reply != 0) {
+                RTC_LOG(LS_ERROR) << "SOCKS5 CONNECT to " << dest_.ToSensitiveString() << " failed, reply " << int(reply);
+                fail(0);
+                return;
+            }
+            [[maybe_unused]] uint16_t port = 0;
+            std::string skipped;
+            if (addressType == 1) {
+                [[maybe_unused]] uint32_t address = 0;
+                if (!response.ReadUInt32(&address) || !response.ReadUInt16(&port)) {
+                    return;
+                }
+            } else if (addressType == 3) {
+                uint8_t length = 0;
+                if (!response.ReadUInt8(&length)
+                    || !response.ReadString(&skipped, length)
+                    || !response.ReadUInt16(&port)) {
+                    return;
+                }
+            } else if (addressType == 4) {
+                if (!response.ReadString(&skipped, 16) || !response.ReadUInt16(&port)) {
+                    return;
+                }
+            } else {
+                fail(0);
+                return;
+            }
+            state_ = State::Tunnel;
+        }
+
+        *len = response.Length();
+        if (*len > 0) {
+            memmove(data, response.Data(), *len);
+        }
+        if (state_ != State::Tunnel) {
+            return;
+        }
+        const auto remainder = (*len > 0);
+        BufferInput(false);
+        SignalConnectEvent(this);
+        if (remainder) {
+            SignalReadEvent(this);
+        }
+    }
+
+private:
+    enum class State {
+        Init,
+        Hello,
+        Auth,
+        Connect,
+        Tunnel,
+        Error,
+    };
+
+    void sendHello() {
+        rtc::ByteBufferWriter request;
+        request.WriteUInt8(5);
+        if (username_.empty()) {
+            request.WriteUInt8(1);
+            request.WriteUInt8(0);
+        } else {
+            request.WriteUInt8(2);
+            request.WriteUInt8(0);
+            request.WriteUInt8(2);
+        }
+        DirectSend(request.Data(), request.Length());
+        state_ = State::Hello;
+    }
+
+    void sendAuth() {
+        rtc::ByteBufferWriter request;
+        request.WriteUInt8(1);
+        request.WriteUInt8(static_cast<uint8_t>(std::min<size_t>(username_.size(), 255)));
+        request.WriteString(absl::string_view(username_).substr(0, 255));
+        request.WriteUInt8(static_cast<uint8_t>(std::min<size_t>(password_.size(), 255)));
+        request.WriteString(absl::string_view(password_).substr(0, 255));
+        DirectSend(request.Data(), request.Length());
+        state_ = State::Auth;
+    }
+
+    void sendConnect() {
+        rtc::ByteBufferWriter request;
+        request.WriteUInt8(5);
+        request.WriteUInt8(1);
+        request.WriteUInt8(0);
+        if (dest_.IsUnresolvedIP()) {
+            const auto hostname = dest_.hostname();
+            request.WriteUInt8(3);
+            request.WriteUInt8(static_cast<uint8_t>(std::min<size_t>(hostname.size(), 255)));
+            request.WriteString(absl::string_view(hostname).substr(0, 255));
+        } else if (dest_.family() == AF_INET6) {
+            const auto address = dest_.ipaddr().ipv6_address();
+            request.WriteUInt8(4);
+            request.WriteBytes(reinterpret_cast<const uint8_t*>(&address), 16);
+        } else {
+            request.WriteUInt8(1);
+            request.WriteUInt32(dest_.ip());
+        }
+        request.WriteUInt16(dest_.port());
+        DirectSend(request.Data(), request.Length());
+        state_ = State::Connect;
+    }
+
+    void fail(int error) {
+        state_ = State::Error;
+        BufferInput(false);
+        BufferedReadAdapter::Close();
+        SetError(SOCKET_EACCES);
+        SignalCloseEvent(this, error);
+    }
+
+    rtc::SocketAddress proxy_;
+    rtc::SocketAddress dest_;
+    std::string username_;
+    std::string password_;
+    State state_ = State::Init;
+};
+
+std::string CryptStringToString(const rtc::CryptString &value) {
+    std::string result(value.GetLength(), '\0');
+    if (!result.empty()) {
+        value.CopyTo(result.data(), false);
+    }
+    return result;
+}
