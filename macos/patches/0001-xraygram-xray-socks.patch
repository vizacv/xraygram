+/*
+This file is part of Xraygram, a fork of Telegram Desktop.
+
+Xraygram runs a bundled xray helper (xraygram-core) as a child process with
+a local SOCKS5 inbound on 127.0.0.1 and points the regular Telegram Desktop
+SOCKS5 proxy at it. Every XRAY entry in the proxy list is a separate
+SOCKS5 entry (own port and password) backed by its own helper process.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#pragma once
+
+#include "mtproto/mtproto_proxy_data.h"
+
+namespace Xraygram {
+
+inline constexpr auto kSocksUser = "xraygram";
+
+struct ApplyResult {
+	MTP::ProxyData proxy;
+	QString error;
+};
+
+struct CheckResult {
+	QString summary;
+	QString error;
+};
+
+// Called from Core::Application::run() after settings are read.
+void Start();
+
+// Called from Core::Application::~Application().
+void Shutdown();
+
+// Called when the proxy settings are applied.
+void EnsureRunning(const MTP::ProxyData &proxy);
+
+// "Add XRAY" gate: while there is no XRAY entry in the proxy list and the
+// user did not explicitly choose a direct connection, nothing may reach
+// Telegram. MTP sessions, the config loader and the Qt application proxy
+// use BlockedProxy() instead of the real settings in that case.
+[[nodiscard]] bool HasXrayEntries();
+[[nodiscard]] bool NetworkBlocked();
+[[nodiscard]] MTP::ProxyData BlockedProxy();
+void AllowDirect();
+
+// XRAY links that are known (xraygram.json) but have no entry in the proxy
+// list, for example after the last XRAY entry was deleted.
+struct SavedEntry {
+	MTP::ProxyData proxy;
+	QString label;
+};
+[[nodiscard]] std::vector<SavedEntry> SavedEntries();
+
+// Starts the helper of a saved entry and returns its SOCKS5 entry.
+[[nodiscard]] ApplyResult ActivateSaved(const MTP::ProxyData &proxy);
+
+[[nodiscard]] bool IsXrayProxy(const MTP::ProxyData &proxy);
+[[nodiscard]] QString LinkFor(const MTP::ProxyData &proxy);
+[[nodiscard]] QString TitleFor(const MTP::ProxyData &proxy);
+
+// "XRAY: <reason>" when the helper of this entry is not running, else empty.
+[[nodiscard]] QString StatusFor(const MTP::ProxyData &proxy);
+
+// Deleted entry: stop its helper, keep the link in saved servers.
+// Restored entry: start the helper again.
+void SetEntryActive(const MTP::ProxyData &proxy, bool active);
+
+// Fires when any helper starts, fails or exits.
+[[nodiscard]] rpl::producer<> StateChanges();
+
+// "vless · example.com · name" from the helper `check` output.
+[[nodiscard]] QString FormatSummary(const QString &summary);
+
+// Synchronous: validates the link, saves it (updating `existing` if it is
+// a known XRAY entry), (re)starts its helper and returns the SOCKS5 entry.
+[[nodiscard]] ApplyResult SaveLink(
+	const QString &link,
+	const MTP::ProxyData &existing);
+
+// Asynchronous validation, `done` is called on the main thread.
+void CheckLink(const QString &link, Fn<void(CheckResult)> done);
+
+// Russian or English: the app language if the user picked one, otherwise
+// the system language.
+[[nodiscard]] QString Tr(const QString &ru, const QString &en);
+
+// True for vless://, vmess://, trojan://, ss://, hysteria2:// and the like.
+[[nodiscard]] bool LooksLikeShareLink(const QString &text);
+
+} // namespace Xraygram
