+[[nodiscard]] std::vector<std::string> XrayCallVersions() {
+	auto result = tgcalls::Meta::Versions();
+	result.erase(ranges::remove_if(result, [](const std::string &v) {
+		return std::atoi(v.c_str()) < 7;
+	}), end(result));
