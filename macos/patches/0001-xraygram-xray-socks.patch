+			&& Xraygram::IsXrayProxy(item.data)
+			&& item.data != current
+			&& _settings.indexInList(item.data) >= 0) {
+			stale.push_back(item.id);
+		}
+	}
+	for (const auto id : stale) {
+		deleteItem(id);
+	}
+}
