@@ -0,0 +1,55 @@
+/*
+This file is part of Xraygram, a fork of Telegram Desktop.
+
+Xraygram runs a bundled xray helper (xraygram-core) as a child process with
+a local SOCKS5 inbound on 127.0.0.1 and points the regular Telegram Desktop
+SOCKS5 proxy at it. The network code of Telegram Desktop is not changed.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#pragma once
+
+#include "mtproto/mtproto_proxy_data.h"
+
+namespace Xraygram {
+
+// Login for the local SOCKS5 inbound, marks "our" proxy entry in the list.
+inline constexpr auto kSocksUser = "xraygram";
+
+struct ApplyResult {
+	MTP::ProxyData proxy;
+	QString error;
+	QString summary; // "vless example.com name"
+};
+
+// Called from Core::Application::run() after settings are read.
+// Starts xray if a link was saved before.
+void Start();
+
+// Called from Core::Application::~Application().
+void Shutdown();
+
+// Called when the proxy settings are applied: (re)starts xray if the
+// selected proxy is ours and the helper is not running.
+void EnsureRunning();
+
+[[nodiscard]] bool IsXrayProxy(const MTP::ProxyData &proxy);
+
+[[nodiscard]] bool Configured();
+[[nodiscard]] bool Running();
+[[nodiscard]] QString CurrentLink();
+[[nodiscard]] MTP::ProxyData CurrentProxy();
+[[nodiscard]] QString StatusText();
+
+// Synchronous (up to a few seconds): validates the link with the helper,
+// saves it, restarts xray and returns the SOCKS5 entry to select.
+[[nodiscard]] ApplyResult SetLink(const QString &link);
+
+// Stops xray and forgets the link. Returns the entry that was used.
+MTP::ProxyData RemoveLink();
+
+// True for vless://, vmess://, trojan://, ss://, hysteria2:// and the like.
+[[nodiscard]] bool LooksLikeShareLink(const QString &text);
+
+} // namespace Xraygram
