diff --git a/Telegram/SourceFiles/xraygram/xraygram_lang.cpp b/Telegram/SourceFiles/xraygram/xraygram_lang.cpp
new file mode 100644
index 0000000..666814c
--- /dev/null
+++ b/Telegram/SourceFiles/xraygram/xraygram_lang.cpp
@@ -0,0 +1,173 @@
+/*
+This file is part of Xraygram, a fork of Telegram Desktop.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#include "xraygram/xraygram_core.h"
+
+#include "lang/lang_keys.h"
+#include "lang/lang_instance.h"
+#include "lang/lang_cloud_manager.h"
+#include "settings.h"
+
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+
+namespace Xraygram {
+namespace {
+
+// The intro choice is kept apart from xraygram.json (servers) on purpose.
+[[nodiscard]] QString UiConfigPath() {
+	return cWorkingDir() + u"tdata/xraygram_ui.json"_q;
+}
+
+[[nodiscard]] bool IsRussianId(const QString &id) {
+	return id.startsWith(u"ru"_q, Qt::CaseInsensitive);
+}
+
+struct Override {
+	std::optional<bool> russian;
+	QString setForId; // Lang::Instance id when the choice was made.
+	bool loaded = false;
+	rpl::event_stream<> changes;
+	rpl::lifetime lifetime;
+};
+
+[[nodiscard]] Override &State() {
+	static auto result = Override();
+	return result;
+}
+
+void Save() {
+	auto &state = State();
+	if (!state.russian) {
+		QFile::remove(UiConfigPath());
+		return;
+	}
+	QDir().mkpath(cWorkingDir() + u"tdata"_q);
+	auto root = QJsonObject();
+	root.insert(u"language"_q, *state.russian ? u"ru"_q : u"en"_q);
+	root.insert(u"setFor"_q, state.setForId);
+	auto file = QFile(UiConfigPath());
+	if (file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		file.write(QJsonDocument(root).toJson(QJsonDocument::Compact));
+	}
+}
+
+[[nodiscard]] bool AppRussian(const Lang::Instance &lang) {
+	// Lang::Instance keeps an empty id until the user picks a language.
+	return lang.id().isEmpty()
+		? IsRussianId(lang.systemLangCode())
+		: (IsRussianId(lang.id()) || IsRussianId(lang.baseId()));
+}
+
+void Watch() {
+	auto &state = State();
+	if (state.lifetime) {
+		return;
+	}
+	// The override ends when the app language caught up with it or the user
+	// picked another language later (in Settings).
+	Lang::GetInstance().updated() | rpl::on_next([] {
+		auto &state = State();
+		const auto &lang = Lang::GetInstance();
+		const auto id = lang.id();
+		if (!state.russian || id.isEmpty()) {
+			return;
+		}
+		const auto caughtUp = (IsRussianId(id) == *state.russian);
+		if (caughtUp || id != state.setForId) {
+			state.russian = std::nullopt;
+			state.setForId = QString();
+			Save();
+		}
+		state.changes.fire({});
+	}, state.lifetime);
+}
+
+void Load() {
+	auto &state = State();
+	if (state.loaded) {
+		return;
+	}
+	state.loaded = true;
+	auto file = QFile(UiConfigPath());
+	if (!file.open(QIODevice::ReadOnly)) {
+		return;
+	}
+	const auto root = QJsonDocument::fromJson(file.readAll()).object();
+	const auto language = root.value(u"language"_q).toString();
+	if (language == u"ru"_q || language == u"en"_q) {
+		state.russian = (language == u"ru"_q);
+		state.setForId = root.value(u"setFor"_q).toString();
+	}
+}
+
+} // namespace
+
+bool UiRussian() {
+	Load();
+	const auto &state = State();
+	return state.russian
+		? *state.russian
+		: AppRussian(Lang::GetInstance());
+}
+
+QString Tr(const QString &ru, const QString &en) {
+	return UiRussian() ? ru : en;
+}
+
+rpl::producer<> UiLanguageChanges() {
+	Watch();
+	return rpl::merge(
+		State().changes.events(),
+		Lang::GetInstance().updated());
+}
+
+rpl::producer<QString> TrValue(QString ru, QString en) {
+	return rpl::single(rpl::empty) | rpl::then(
+		UiLanguageChanges()
+	) | rpl::map([=] {
+		return Tr(ru, en);
+	});
+}
+
+void SetUiLanguage(bool russian) {
+	Load();
+	Watch();
+	auto &state = State();
+	auto &lang = Lang::GetInstance();
+	auto &cloud = Lang::CurrentCloudManager();
+	const auto current = Lang::LanguageIdOrDefault(lang.id());
+	if (russian) {
+		if (!IsRussianId(current)) {
+			// Waits for the network (XRAY), then applies without restart
+			// while no account is authorized.
+			cloud.switchToLanguage(u"ru"_q);
+		}
+	} else if (current != Lang::DefaultLanguageId()) {
+		cloud.resetToDefault();
+	}
+	if (AppRussian(lang) == russian) {
+		state.russian = std::nullopt;
+		state.setForId = QString();
+	} else {
+		state.russian = russian;
+		state.setForId = lang.id();
+	}
+	Save();
+	state.changes.fire({});
+}
+
+void ResumeUiLanguage() {
+	Load();
+	Watch();
+	const auto &state = State();
+	const auto current = Lang::LanguageIdOrDefault(Lang::GetInstance().id());
+	if (state.russian && *state.russian && !IsRussianId(current)) {
+		Lang::CurrentCloudManager().switchToLanguage(u"ru"_q);
+	}
+}
+
+} // namespace Xraygram
