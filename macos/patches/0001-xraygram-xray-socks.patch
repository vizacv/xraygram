+/*
+This file is part of Xraygram, a fork of Telegram Desktop.
+
+Xraygram runs a bundled xray helper (xraygram-core) as a child process with
+a local SOCKS5 inbound on 127.0.0.1 and points the regular Telegram Desktop
+SOCKS5 proxy at it. Every XRAY entry in the proxy list is a separate
+SOCKS5 entry (own port and password) backed by its own helper process.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#pragma once
+
+#include "mtproto/mtproto_proxy_data.h"
+
+namespace Xraygram {
+
+inline constexpr auto kSocksUser = "xraygram";
+
+struct ApplyResult {
+	MTP::ProxyData proxy;
+	QString error;
+};
+
+struct CheckResult {
+	QString summary;
+	QString error;
+};
+
+// Called from Core::Application::run() after settings are read.
+void Start();
+
+// Called from Core::Application::~Application().
+void Shutdown();
+
+// Called when the proxy settings are applied.
+void EnsureRunning(const MTP::ProxyData &proxy);
+
+[[nodiscard]] bool IsXrayProxy(const MTP::ProxyData &proxy);
+[[nodiscard]] QString LinkFor(const MTP::ProxyData &proxy);
+[[nodiscard]] QString TitleFor(const MTP::ProxyData &proxy);
+
+// "vless · example.com · name" from the helper `check` output.
+[[nodiscard]] QString FormatSummary(const QString &summary);
+
+// Synchronous: validates the link, saves it (updating `existing` if it is
+// a known XRAY entry), (re)starts its helper and returns the SOCKS5 entry.
+[[nodiscard]] ApplyResult SaveLink(
+	const QString &link,
+	const MTP::ProxyData &existing);
+
+// Asynchronous validation, `done` is called on the main thread.
+void CheckLink(const QString &link, Fn<void(CheckResult)> done);
+
+// True for vless://, vmess://, trojan://, ss://, hysteria2:// and the like.
+[[nodiscard]] bool LooksLikeShareLink(const QString &text);
+
+} // namespace Xraygram
