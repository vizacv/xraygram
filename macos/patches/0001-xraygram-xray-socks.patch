+
+bool Step::paintXrayCover(QPainter &p, int top) {
+	if (!_xrayIconLoaded) {
+		_xrayIconLoaded = true;
+		_xrayIcon = Xraygram::BrandImage(u"logo.png"_q);
+	}
+	if (_xrayIcon.isNull()) {
+		return false;
+	}
+	auto coverHeight = top + st::introCoverHeight;
+	if (coverHeight > 0) {
+		p.drawPixmap(
+			QRect(0, 0, width(), coverHeight),
+			_coverMask,
+			QRect(
+				0,
+				-top * style::DevicePixelRatio(),
+				_coverMask.width(),
+				coverHeight * style::DevicePixelRatio()));
+	}
+
+	// logo.png is the macOS icon: a rounded square of 824/1024 with a
+	// transparent margin; the beam stays inside that square.
+	const auto size = st::introCoverHeight - 2 * st::introCoverIconTop
+		+ st::introCoverIconTop / 2;
+	const auto iconRect = QRect(
+		(width() - size) / 2,
+		top + (st::introCoverHeight - size) / 2,
+		size,
+		size);
+	{
+		auto hq = PainterHighQualityEnabler(p);
+		p.drawImage(iconRect, _xrayIcon);
+	}
+	if (!_xrayBeam.animating()) {
+		return true;
+	}
+	const auto margin = iconRect.width() * 100. / 1024.;
+	const auto inner = QRectF(iconRect).marginsRemoved(
+		{ margin, margin, margin, margin });
+	const auto radius = inner.width() * 185.4 / 824.;
+	const auto progress = _xrayBeam.value(1.);
+	const auto band = inner.height() * 0.22;
+	const auto y = inner.top() - band
+		+ (inner.height() + 2 * band) * progress;
+
+	auto clip = QPainterPath();
+	clip.addRoundedRect(inner, radius, radius);
+	p.save();
+	auto hq = PainterHighQualityEnabler(p);
+	p.setClipPath(clip);
+	auto accent = QColor(0x3E, 0xF2, 0xC8);
+	auto gradient = QLinearGradient(0., y - band, 0., y + band);
+	accent.setAlphaF(0.);
+	gradient.setColorAt(0., accent);
+	accent.setAlphaF(0.55);
+	gradient.setColorAt(0.5, accent);
+	accent.setAlphaF(0.);
+	gradient.setColorAt(1., accent);
+	p.fillRect(
+		QRectF(inner.left(), y - band, inner.width(), 2 * band),
+		gradient);
+	const auto line = std::max(1., inner.height() / 96.);
+	p.fillRect(
+		QRectF(inner.left(), y - line / 2., inner.width(), line),
+		QColor(0x8F, 0xFB, 0xE0));
+	p.restore();
+	return true;
+}
