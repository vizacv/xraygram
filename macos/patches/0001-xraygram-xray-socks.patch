+
+namespace Xraygram {
+namespace {
+
+constexpr auto kHost = "127.0.0.1";
+constexpr auto kStartTimeout = 5000;
+constexpr auto kCheckTimeout = 5000;
+constexpr auto kStopTimeout = 2000;
+constexpr auto kRestartDelay = crl::time(3000);
+constexpr auto kMaxRestartDelay = crl::time(120000);
+constexpr auto kStableRunTime = crl::time(60000);
+constexpr auto kMaxTailSize = 4096;
+constexpr auto kMaxSaved = 20;
+
+struct Entry {
+	QString link;
+	int port = 0;
+	QString password;
+	QString summary;
+};
+
+[[nodiscard]] QString ConfigPath() {
+	return cWorkingDir() + u"tdata/xraygram.json"_q;
+}
+
+[[nodiscard]] QString HelperPath() {
+	const auto custom = qEnvironmentVariable("XRAYGRAM_CORE");
+	return custom.isEmpty()
+		? (QCoreApplication::applicationDirPath() + u"/xraygram-core"_q)
+		: custom;
+}
+
+[[nodiscard]] Entry ParseEntry(const QJsonObject &object) {
+	return {
+		.link = object.value(u"link"_q).toString().trimmed(),
+		.port = object.value(u"port"_q).toInt(),
+		.password = object.value(u"password"_q).toString(),
+		.summary = object.value(u"summary"_q).toString(),
+	};
+}
+
+struct Stored {
+	std::vector<Entry> entries;
+	bool directAllowed = false;
+};
+
+[[nodiscard]] Stored ReadStored() {
+	auto file = QFile(ConfigPath());
+	if (!file.open(QIODevice::ReadOnly)) {
+		return {};
+	}
+	const auto object = QJsonDocument::fromJson(file.readAll()).object();
+	auto result = std::vector<Entry>();
+	if (object.contains(u"entries"_q)) {
+		for (const auto &value : object.value(u"entries"_q).toArray()) {
+			result.push_back(ParseEntry(value.toObject()));
+		}
+	} else if (object.contains(u"link"_q)) {
+		result.push_back(ParseEntry(object));
+	}
+	result.erase(ranges::remove_if(result, [](const Entry &entry) {
+		return entry.link.isEmpty()
+			|| entry.password.isEmpty()
+			|| entry.port <= 0;
+	}), end(result));
+	return {
+		.entries = std::move(result),
+		.directAllowed = object.value(u"directAllowed"_q).toBool(),
+	};
+}
+
+bool WriteEntries(
+		const std::vector<const Entry*> &entries,
+		bool directAllowed) {
+	QDir().mkpath(cWorkingDir() + u"tdata"_q);
+	const auto path = ConfigPath();
+	if (entries.empty() && !directAllowed) {
+		return !QFile::exists(path) || QFile::remove(path);
+	}
+	auto list = QJsonArray();
+	for (const auto entry : entries) {
+		auto object = QJsonObject();
+		object.insert(u"link"_q, entry->link);
+		object.insert(u"port"_q, entry->port);
+		object.insert(u"password"_q, entry->password);
+		object.insert(u"summary"_q, entry->summary);
+		list.append(object);
+	}
+	auto root = QJsonObject();
+	root.insert(u"version"_q, 2);
+	root.insert(u"entries"_q, list);
+	if (directAllowed) {
+		root.insert(u"directAllowed"_q, true);
+	}
+
+	auto file = QFile(path);
+	if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		LOG(("Xraygram Error: could not write %1").arg(path));
+		return false;
+	}
+	file.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+	file.write(QJsonDocument(root).toJson(QJsonDocument::Indented));
+	return true;
+}
+
+[[nodiscard]] bool PortFree(int port) {
+	if (port <= 0 || port > 65535) {
+		return false;
+	}
+	auto server = QTcpServer();
+	const auto result = server.listen(QHostAddress::LocalHost, quint16(port));
+	server.close();
+	return result;
+}
+
+[[nodiscard]] int PickFreePort(const std::vector<int> &taken) {
+	for (auto attempt = 0; attempt != 16; ++attempt) {
+		auto server = QTcpServer();
+		if (!server.listen(QHostAddress::LocalHost, 0)) {
+			return 0;
+		}
+		const auto result = int(server.serverPort());
+		server.close();
+		if (!ranges::contains(taken, result)) {
+			return result;
+		}
+	}
+	return 0;
+}
+
+[[nodiscard]] QString RandomPassword() {
+	auto result = QString();
+	auto *generator = QRandomGenerator::system();
+	for (auto i = 0; i != 4; ++i) {
+		result += QString::number(generator->generate64(), 16);
+	}
+	return result;
+}
+
+[[nodiscard]] MTP::ProxyData ProxyFor(const Entry &entry) {
+	auto result = MTP::ProxyData();
+	result.type = MTP::ProxyData::Type::Socks5;
+	result.host = QString::fromLatin1(kHost);
+	result.port = uint32(entry.port);
+	result.user = QString::fromLatin1(kSocksUser);
+	result.password = entry.password;
+	return result;
+}
+
+[[nodiscard]] QString FirstLine(const QByteArray &data) {
+	const auto text = QString::fromUtf8(data).trimmed();
+	const auto index = text.indexOf('\n');
+	return (index < 0) ? text : text.mid(0, index).trimmed();
+}
+
+[[nodiscard]] QString StripPrefix(QString text, const QString &prefix) {
+	return text.startsWith(prefix) ? text.mid(prefix.size()).trimmed() : text;
+}
+
+[[nodiscard]] QStringList SplitSummary(const QString &summary) {
+	const auto first = summary.indexOf(' ');
+	if (first < 0) {
+		return { summary };
+	}
+	const auto second = summary.indexOf(' ', first + 1);
+	if (second < 0) {
+		return { summary.mid(0, first), summary.mid(first + 1) };
+	}
+	return {
+		summary.mid(0, first),
+		summary.mid(first + 1, second - first - 1),
+		summary.mid(second + 1).trimmed(),
+	};
+}
+
+[[nodiscard]] QString EmptyLinkError() {
+	return Tr(u"Вставьте ссылку на сервер"_q, u"Paste the server link"_q);
+}
+
+[[nodiscard]] QString CheckFailedError() {
+	return Tr(
+		u"Не удалось проверить ссылку. Попробуйте ещё раз"_q,
+		u"Could not check the link. Try again"_q);
+}
+
+[[nodiscard]] QString HumanCheckError(const QString &raw) {
+	if (raw.isEmpty()) {
+		return CheckFailedError();
+	} else if (raw.contains(u"empty link"_q)) {
+		return EmptyLinkError();
+	} else if (raw.contains(u"unsupported share format"_q)) {
+		return Tr(
+			u"Это не ссылка на сервер. Нужна ссылка vless://, vmess://, "
+			"trojan://, ss:// или hysteria2://"_q,
+			u"This is not a server link. Use vless://, vmess://, "
+			"trojan://, ss:// or hysteria2://"_q);
+	} else if (raw.contains(u"no valid outbound found"_q)) {
+		return Tr(
+			u"В ссылке не хватает данных (адрес, порт, ключ или "
+			"параметры). Скопируйте её целиком ещё раз"_q,
+			u"The link is incomplete (address, port, key or parameters). "
+			"Copy the whole link again"_q);
+	}
+	return Tr(
+		u"Ссылка не распознана (%1)"_q,
+		u"Link not recognized (%1)"_q).arg(raw);
+}
+
+[[nodiscard]] std::optional<CheckResult> PrecheckLink(const QString &link) {
+	const auto trimmed = link.trimmed();
+	if (trimmed.isEmpty()) {
+		return CheckResult{ .error = EmptyLinkError() };
+	} else if (trimmed.startsWith(u"http://"_q, Qt::CaseInsensitive)
+		|| trimmed.startsWith(u"https://"_q, Qt::CaseInsensitive)) {
+		return CheckResult{
+			.error = Tr(
+				u"Это ссылка на сайт или подписку. Нужна ссылка на "
+				"один сервер: vless://, vmess://, trojan://, ss:// или "
+				"hysteria2://"_q,
+				u"This is a web or subscription link. A single-server "
+				"link is needed: vless://, vmess://, trojan://, ss:// or "
+				"hysteria2://"_q),
+		};
+	}
+	return std::nullopt;
+}
+
+[[nodiscard]] CheckResult ParseCheck(QProcess &process) {
+	const auto out = FirstLine(process.readAllStandardOutput());
+	if (process.exitStatus() == QProcess::NormalExit
+		&& process.exitCode() == 0
+		&& out.startsWith(u"OK"_q)) {
+		return { .summary = StripPrefix(out, u"OK"_q) };
+	}
+	const auto raw = StripPrefix(
+		FirstLine(process.readAllStandardError()),
+		u"ERROR"_q);
+	DEBUG_LOG(("Xraygram: link check failed: %1").arg(raw));
+	return { .error = HumanCheckError(raw) };
+}
+
+[[nodiscard]] QString HostOnly(const QString &endpoint) {
+	if (endpoint.startsWith('[')) {
+		const auto end = endpoint.indexOf(']');
+		return (end > 0) ? endpoint.mid(1, end - 1) : endpoint;
+	} else if (endpoint.count(':') == 1) {
+		return endpoint.mid(0, endpoint.indexOf(':'));
+	}
+	return endpoint;
+}
+
+[[nodiscard]] QString TitleForSummary(const QString &summary) {
+	const auto parts = SplitSummary(summary);
+	if (parts.size() > 2 && !parts[2].isEmpty()) {
+		return parts[2];
+	} else if (parts.size() > 1 && !parts[1].isEmpty()) {
+		return HostOnly(parts[1]);
+	}
+	return QString();
+}
+
+[[nodiscard]] CheckResult CheckSync(const QString &link) {
+	if (auto result = PrecheckLink(link)) {
+		return *result;
+	}
+	auto process = QProcess();
+	process.setProgram(HelperPath());
+	process.setArguments({ u"check"_q });
+	process.start();
+	if (!process.waitForStarted(kCheckTimeout)) {
+		LOG(("Xraygram Error: could not start %1: %2"
+			).arg(HelperPath(), process.errorString()));
+		return { .error = CheckFailedError() };
+	}
+	process.write(link.toUtf8());
+	process.closeWriteChannel();
+	if (!process.waitForFinished(kCheckTimeout)) {
+		process.kill();
+		process.waitForFinished(kStopTimeout);
+		LOG(("Xraygram Error: link check timeout."));
+		return { .error = CheckFailedError() };
+	}
+	return ParseCheck(process);
+}
+
+class Instance final {
+public:
+	Instance(Entry entry, Fn<void()> changed, Fn<void()> notify);
+	~Instance();
+
+	[[nodiscard]] const Entry &entry() const;
+	[[nodiscard]] MTP::ProxyData proxy() const;
+	[[nodiscard]] bool running() const;
+	[[nodiscard]] QString lastError() const;
+	[[nodiscard]] QString statusText() const;
+	void setDisabled(bool disabled);
+
+	void setLink(const QString &link, const QString &summary);
+	bool start();
+	void ensureRunning();
+	void stop();
+
+private:
+	bool launch();
+	bool tryLaunch();
+	bool ensurePort();
+	void restart();
+	void readLogs();
+	void processFinished(int exitCode);
+	void noteFailure();
+	void scheduleRestart();
+	[[nodiscard]] crl::time backoff() const;
+
+	Entry _entry;
+	Fn<void()> _changed;
+	Fn<void()> _notify;
+	std::unique_ptr<QObject> _guard;
+	std::unique_ptr<QProcess> _process;
+	QByteArray _tail;
+	QString _lastError;
+	bool _ready = false;
+	bool _restartScheduled = false;
+	bool _disabled = false;
+	int _failures = 0;
+	crl::time _startedAt = 0;
+	crl::time _nextAttemptAt = 0;
+
+};
+
+Instance::Instance(Entry entry, Fn<void()> changed, Fn<void()> notify)
+: _entry(std::move(entry))
+, _changed(std::move(changed))
+, _notify(std::move(notify))
+, _guard(std::make_unique<QObject>()) {
+}
+
+QString Instance::statusText() const {
+	if (_disabled || running()) {
+		return QString();
+	} else if (_entry.port <= 0) {
+		return Tr(
+			u"XRAY: нет свободного локального порта"_q,
+			u"XRAY: no free local port"_q);
+	} else if (_restartScheduled) {
+		const auto left = std::max(_nextAttemptAt - crl::now(), crl::time(0));
+		return Tr(
+			u"XRAY: перезапуск через %1 с"_q,
+			u"XRAY: restarting in %1 s"_q).arg((left + 999) / 1000);
+	} else if (!_lastError.isEmpty()) {
+		return Tr(
+			u"XRAY: не удалось запустить"_q,
+			u"XRAY: failed to start"_q);
+	}
+	return QString();
+}
+
+void Instance::setDisabled(bool disabled) {
+	_disabled = disabled;
+	if (disabled) {
+		stop();
+		_lastError = QString();
+	}
+	if (_notify) {
+		_notify();
+	}
+}
+
+Instance::~Instance() {
+	stop();
+}
+
+const Entry &Instance::entry() const {
+	return _entry;
+}
+
+MTP::ProxyData Instance::proxy() const {
+	return ProxyFor(_entry);
+}
+
+bool Instance::running() const {
+	return _process
+		&& _ready
+		&& (_process->state() == QProcess::Running);
+}
+
+QString Instance::lastError() const {
+	return _lastError;
+}
+
+void Instance::setLink(const QString &link, const QString &summary) {
+	stop();
+	_entry.link = link;
+	_entry.summary = summary;
+	_failures = 0;
+	_nextAttemptAt = 0;
+}
+
+bool Instance::start() {
+	_disabled = false;
+	ensurePort();
+	return launch();
+}
+
+void Instance::ensureRunning() {
+	if (!_disabled
+		&& !running()
+		&& !_restartScheduled
+		&& crl::now() >= _nextAttemptAt) {
+		launch();
+	}
+}
+
+void Instance::restart() {
+	if (_disabled || running()) {
+		return;
+	}
+	const auto selectedChanged = ensurePort();
+	if (!launch()) {
+		scheduleRestart();
+	}
+	if (selectedChanged) {
+		auto &settings = Core::App().settings().proxy();
+		Core::App().setCurrentProxy(proxy(), settings.settings());
+	}
+}
+
+crl::time Instance::backoff() const {
+	auto result = kRestartDelay;
+	for (auto i = 1; i < _failures && result < kMaxRestartDelay; ++i) {
+		result *= 2;
+	}
+	return std::min(result, kMaxRestartDelay);
+}
+
+void Instance::noteFailure() {
+	++_failures;
+	_nextAttemptAt = crl::now() + backoff();
+}
+
+bool Instance::ensurePort() {
+	if (PortFree(_entry.port)) {
+		return false;
+	}
+	const auto was = proxy();
+	const auto port = PickFreePort({ _entry.port });
+	if (port <= 0) {
+		return false;
+	}
+	_entry.port = port;
+	const auto now = proxy();
+	LOG(("Xraygram: port busy, moving SOCKS5 inbound to %1"
+		).arg(_entry.port));
+	if (_changed) {
+		_changed();
+	}
+
+	auto &settings = Core::App().settings().proxy();
+	const auto selectedChanged = (settings.selected() == was);
+	if (selectedChanged) {
+		settings.setSelected(now);
+	}
+	if (!settings.replaceInList(was, now) && selectedChanged) {
+		settings.addToList(now);
+	}
+	Core::App().saveSettingsDelayed();
+	return selectedChanged;
+}
+
+bool Instance::launch() {
+	const auto guard = gsl::finally([&] {
+		if (_notify) {
+			_notify();
+		}
+	});
+	if (tryLaunch()) {
+		_startedAt = crl::now();
+		return true;
+	}
+	noteFailure();
+	return false;
+}
+
+bool Instance::tryLaunch() {
+	stop();
+	_lastError = QString();
+	const auto path = HelperPath();
+	if (!QFile::exists(path)) {
+		_lastError = Tr(u"не найден %1"_q, u"%1 not found"_q).arg(path);
+		LOG(("Xraygram Error: %1").arg(_lastError));
+		return false;
+	}
+
+	_process = std::make_unique<QProcess>();
+	const auto raw = _process.get();
+	auto environment = QProcessEnvironment::systemEnvironment();
+	environment.insert(
+		u"XRAYGRAM_SOCKS_USER"_q,
+		QString::fromLatin1(kSocksUser));
+	environment.insert(u"XRAYGRAM_SOCKS_PASS"_q, _entry.password);
+	raw->setProcessEnvironment(environment);
+	raw->setProgram(path);
+	raw->setArguments({
+		u"run"_q,
+		u"-listen"_q,
+		u"%1:%2"_q.arg(QString::fromLatin1(kHost)).arg(_entry.port),
+	});
+	_ready = false;
+	_tail = QByteArray();
+	raw->start();
+	if (!raw->waitForStarted(kStartTimeout)) {
+		_lastError = raw->errorString();
+		LOG(("Xraygram Error: start failed: %1").arg(_lastError));
+		_process = nullptr;
+		return false;
+	}
+	raw->write(_entry.link.toUtf8());
+	raw->closeWriteChannel();
+
+	auto timer = QElapsedTimer();
+	timer.start();
+	auto out = QByteArray();
+	while (!out.contains("READY")) {
+		const auto left = kStartTimeout - timer.elapsed();
+		if (left <= 0 || !raw->waitForReadyRead(int(left))) {
+			break;
+		}
+		out += raw->readAllStandardOutput();
+	}
+	if (!out.contains("READY")) {
+		const auto error = FirstLine(raw->readAllStandardError());
+		_lastError = error.isEmpty()
+			? Tr(
+				u"xraygram-core не ответил"_q,
+				u"xraygram-core did not respond"_q)
+			: StripPrefix(error, u"ERROR"_q);
+		LOG(("Xraygram Error: %1").arg(_lastError));
+		stop();
+		return false;
+	}
+	const auto ready = QString::fromUtf8(out);
+	const auto index = ready.indexOf(u"READY"_q);
+	const auto summary = FirstLine(ready.mid(index + 5).toUtf8());
+	_ready = true;
+	LOG(("Xraygram: xray started on %1:%2 (%3)"
+		).arg(QString::fromLatin1(kHost)
+		).arg(_entry.port
+		).arg(summary));
+	if (!summary.isEmpty() && summary != _entry.summary) {
+		_entry.summary = summary;
+		if (_changed) {
+			_changed();
+		}
+	}
+
+	QObject::connect(
+		raw,
+		&QProcess::readyReadStandardOutput,
+		_guard.get(),
+		[=] { readLogs(); });
+	QObject::connect(
+		raw,
+		&QProcess::readyReadStandardError,
+		_guard.get(),
+		[=] { readLogs(); });
+	QObject::connect(
+		raw,
+		&QProcess::finished,
+		_guard.get(),
+		[=](int exitCode, QProcess::ExitStatus) {
+			processFinished(exitCode);
+		});
+	if (raw->state() != QProcess::Running) {
+		_startedAt = crl::now();
+		processFinished(raw->exitCode());
+	}
+	return true;
+}
+
+void Instance::readLogs() {
+	if (!_process) {
+		return;
+	}
+	const auto data = _process->readAllStandardOutput()
+		+ _process->readAllStandardError();
+	if (data.isEmpty()) {
+		return;
+	}
+	_tail = (_tail + data).right(kMaxTailSize);
+	for (const auto &line : data.split('\n')) {
+		const auto trimmed = line.trimmed();
+		if (!trimmed.isEmpty()) {
+			DEBUG_LOG(("Xray: %1").arg(QString::fromUtf8(trimmed)));
+		}
+	}
+}
+
+void Instance::processFinished(int exitCode) {
+	readLogs();
+	const auto tail = QString::fromUtf8(_tail).trimmed();
+	_lastError = Tr(
+		u"xray завершился (код %1)"_q,
+		u"xray exited (code %1)"_q).arg(exitCode);
+	LOG(("Xraygram Error: %1, log tail: %2").arg(_lastError, tail));
+	_ready = false;
+	if (_process) {
+		_process->disconnect(_guard.get());
+		_process.release()->deleteLater();
+	}
+	if (crl::now() - _startedAt >= kStableRunTime) {
+		_failures = 0;
+	}
+	noteFailure();
+	scheduleRestart();
+	if (_notify) {
+		_notify();
+	}
+}
+
+void Instance::scheduleRestart() {
+	if (_restartScheduled || _disabled) {
+		return;
+	}
+	_restartScheduled = true;
+	QTimer::singleShot(int(backoff()), _guard.get(), [=] {
+		_restartScheduled = false;
+		restart();
+	});
+}
+
+void Instance::stop() {
+	_ready = false;
+	auto process = base::take(_process);
+	if (!process) {
+		return;
+	}
+	process->disconnect(_guard.get());
+	if (process->state() != QProcess::NotRunning) {
+		process->terminate();
+		if (!process->waitForFinished(kStopTimeout)) {
+			process->kill();
+			process->waitForFinished(kStopTimeout);
+		}
+	}
+}
+
+class Manager final {
+public:
+	Manager();
+
+	void start();
+	void shutdown();
+	void ensureRunning(const MTP::ProxyData &proxy);
+
+	[[nodiscard]] Instance *find(const MTP::ProxyData &proxy) const;
+	[[nodiscard]] ApplyResult saveLink(
+		const QString &link,
+		const MTP::ProxyData &existing);
+	void checkLink(const QString &link, Fn<void(CheckResult)> done);
+
+	[[nodiscard]] bool directAllowed() const;
+	void allowDirect();
+	[[nodiscard]] std::vector<SavedEntry> saved() const;
+	[[nodiscard]] ApplyResult activate(const MTP::ProxyData &proxy);
+	void setActive(const MTP::ProxyData &proxy, bool active);
+	[[nodiscard]] rpl::producer<> stateChanges() const;
+
+private:
+	void save();
+	[[nodiscard]] std::vector<int> takenPorts() const;
+	Instance *add(Entry entry);
+
+	std::unique_ptr<QObject> _guard;
+	std::vector<std::unique_ptr<Instance>> _instances;
+	rpl::event_stream<> _stateChanges;
+	bool _directAllowed = false;
+	bool _shutdown = false;
+
+};
+
+Manager::Manager() : _guard(std::make_unique<QObject>()) {
+}
+
+void Manager::start() {
+	const auto &settings = Core::App().settings().proxy();
+	auto stored = ReadStored();
+	_directAllowed = stored.directAllowed;
+	for (auto &entry : stored.entries) {
+		add(std::move(entry));
+	}
+	for (const auto &instance : _instances) {
+		const auto proxy = instance->proxy();
+		if (settings.indexInList(proxy) >= 0 || settings.selected() == proxy) {
+			instance->start();
+		} else {
+			instance->setDisabled(true);
+		}
+	}
+}
+
+void Manager::setActive(const MTP::ProxyData &proxy, bool active) {
+	const auto instance = find(proxy);
+	if (!instance) {
+		return;
+	} else if (active) {
+		instance->start();
+	} else {
+		instance->setDisabled(true);
+		save();
+	}
+}
+
+rpl::producer<> Manager::stateChanges() const {
+	return _stateChanges.events();
+}
+
+std::vector<SavedEntry> Manager::saved() const {
+	const auto &settings = Core::App().settings().proxy();
+	auto result = std::vector<SavedEntry>();
+	auto links = QStringList();
+	for (auto i = _instances.rbegin(); i != _instances.rend(); ++i) {
+		const auto &entry = (*i)->entry();
+		const auto proxy = (*i)->proxy();
+		if (settings.indexInList(proxy) >= 0 || links.contains(entry.link)) {
+			continue;
+		}
+		links.push_back(entry.link);
+		const auto title = TitleForSummary(entry.summary);
+		result.push_back({
+			.proxy = proxy,
+			.label = title.isEmpty() ? u"XRAY"_q : title,
+		});
+		if (int(result.size()) == kMaxSaved) {
+			break;
+		}
+	}
+	return result;
+}
+
+ApplyResult Manager::activate(const MTP::ProxyData &proxy) {
+	const auto instance = find(proxy);
+	if (!instance) {
+		return { .error = Tr(u"запись не найдена"_q, u"entry not found"_q) };
+	}
+	if (!instance->running() && (!instance->start() || !instance->running())) {
+		return { .proxy = instance->proxy(), .error = instance->lastError() };
+	}
+	_directAllowed = false;
+	save();
+	return { .proxy = instance->proxy() };
+}
+
+void Manager::shutdown() {
+	_shutdown = true;
+	_instances.clear();
+	_guard = nullptr;
+}
+
+void Manager::ensureRunning(const MTP::ProxyData &proxy) {
+	if (const auto instance = find(proxy)) {
+		instance->ensureRunning();
+	}
+}
+
+Instance *Manager::find(const MTP::ProxyData &proxy) const {
+	if (!IsXrayProxy(proxy)) {
+		return nullptr;
+	}
+	for (const auto &instance : _instances) {
+		const auto &entry = instance->entry();
+		if (entry.port == int(proxy.port)
+			&& entry.password == proxy.password) {
+			return instance.get();
+		}
+	}
+	return nullptr;
+}
+
+Instance *Manager::add(Entry entry) {
+	_instances.push_back(std::make_unique<Instance>(
+		std::move(entry),
+		[=] { save(); },
+		[=] { _stateChanges.fire({}); }));
+	return _instances.back().get();
+}
+
+std::vector<int> Manager::takenPorts() const {
+	auto result = std::vector<int>();
+	for (const auto &instance : _instances) {
+		result.push_back(instance->entry().port);
+	}
+	return result;
+}
+
+void Manager::save() {
+	if (_shutdown) {
+		return;
+	}
+	const auto &settings = Core::App().settings().proxy();
+	auto inactive = 0;
+	for (auto i = int(_instances.size()); i != 0; --i) {
+		const auto proxy = _instances[i - 1]->proxy();
+		if (settings.indexInList(proxy) >= 0 || settings.selected() == proxy) {
+			continue;
+		} else if (++inactive > kMaxSaved) {
+			_instances.erase(begin(_instances) + (i - 1));
+		}
+	}
+	auto entries = std::vector<const Entry*>();
+	for (const auto &instance : _instances) {
+		entries.push_back(&instance->entry());
+	}
+	WriteEntries(entries, _directAllowed);
+}
+
+bool Manager::directAllowed() const {
+	return _directAllowed;
+}
+
+void Manager::allowDirect() {
+	LOG(("Xraygram: the user chose to connect directly, without XRAY."));
+	_directAllowed = true;
+	save();
+}
+
+ApplyResult Manager::saveLink(
+		const QString &link,
+		const MTP::ProxyData &existing) {
+	const auto trimmed = link.trimmed();
+	const auto checked = CheckSync(trimmed);
+	if (!checked.error.isEmpty()) {
+		return { .error = checked.error };
+	}
+	_directAllowed = false;
+	auto instance = find(existing);
+	if (!instance) {
+		const auto &settings = Core::App().settings().proxy();
+		const auto i = ranges::find_if(_instances, [&](const auto &other) {
+			return (other->entry().link == trimmed)
+				&& (settings.indexInList(other->proxy()) < 0);
+		});
+		if (i != end(_instances)) {
+			auto moved = std::move(*i);
+			_instances.erase(i);
+			_instances.push_back(std::move(moved));
+			instance = _instances.back().get();
+		}
+	}
+	if (instance) {
+		instance->setLink(trimmed, checked.summary);
+	} else {
+		const auto port = PickFreePort(takenPorts());
+		if (port <= 0) {
+			return {
+				.error = Tr(
+					u"нет свободного локального порта"_q,
+					u"no free local port"_q),
+			};
+		}
+		instance = add({
+			.link = trimmed,
+			.port = port,
+			.password = RandomPassword(),
+			.summary = checked.summary,
+		});
+	}
+	save();
+	if (!instance->start() || !instance->running()) {
+		return {
+			.proxy = instance->proxy(),
+			.error = instance->lastError(),
+		};
+	}
+	return { .proxy = instance->proxy() };
+}
+
+void Manager::checkLink(const QString &link, Fn<void(CheckResult)> done) {
+	if (!_guard) {
+		return;
+	} else if (auto result = PrecheckLink(link)) {
+		done(std::move(*result));
+		return;
+	}
+	const auto process = new QProcess(_guard.get());
+	const auto finish = [=](CheckResult result) {
+		process->disconnect();
+		process->deleteLater();
+		done(std::move(result));
+	};
+	QObject::connect(
+		process,
+		&QProcess::finished,
+		process,
+		[=](int, QProcess::ExitStatus) { finish(ParseCheck(*process)); });
+	QObject::connect(
+		process,
+		&QProcess::errorOccurred,
+		process,
+		[=](QProcess::ProcessError error) {
+			if (error == QProcess::FailedToStart) {
+				LOG(("Xraygram Error: could not start %1").arg(HelperPath()));
+				finish({ .error = CheckFailedError() });
+			}
+		});
+	QTimer::singleShot(kCheckTimeout, process, [=] {
+		process->kill();
+	});
+	process->setProgram(HelperPath());
+	process->setArguments({ u"check"_q });
+	process->start();
+	process->write(link.trimmed().toUtf8());
+	process->closeWriteChannel();
+}
+
+[[nodiscard]] Manager &Get() {
+	static auto result = Manager();
+	return result;
+}
+
+} // namespace
+
+void Start() {
+	Get().start();
+}
+
+void Shutdown() {
+	Get().shutdown();
+}
+
+void EnsureRunning(const MTP::ProxyData &proxy) {
+	Get().ensureRunning(proxy);
+}
+
+bool HasXrayEntries() {
+	const auto &list = Core::App().settings().proxy().list();
+	return ranges::any_of(list, IsXrayProxy);
+}
+
+bool NetworkBlocked() {
+	const auto direct = Get().directAllowed();
+	const auto xray = HasXrayEntries();
+	const auto result = !direct && !xray;
+	static auto logged = std::optional<bool>();
+	if (logged != result) {
+		logged = result;
+		LOG(("Xraygram: network %1 (XRAY entries: %2, direct allowed: %3)."
+			).arg(result ? u"BLOCKED"_q : u"unblocked"_q
+			).arg(xray ? u"yes"_q : u"no"_q
+			).arg(direct ? u"yes"_q : u"no"_q));
+	}
+	return result;
+}
+
+MTP::ProxyData BlockedProxy() {
+	auto result = MTP::ProxyData();
+	result.type = MTP::ProxyData::Type::Socks5;
+	result.host = QString::fromLatin1(kHost);
+	result.port = 1;
+	result.user = u"xraygram-blocked"_q;
+	result.password = u"blocked"_q;
+	return result;
+}
+
+void AllowDirect() {
+	Get().allowDirect();
+}
+
+std::vector<SavedEntry> SavedEntries() {
+	return Get().saved();
+}
+
+ApplyResult ActivateSaved(const MTP::ProxyData &proxy) {
+	return Get().activate(proxy);
+}
+
+bool IsXrayProxy(const MTP::ProxyData &proxy) {
+	return (proxy.type == MTP::ProxyData::Type::Socks5)
+		&& (proxy.host == QString::fromLatin1(kHost))
+		&& (proxy.user == QString::fromLatin1(kSocksUser));
+}
+
+QString LinkFor(const MTP::ProxyData &proxy) {
+	const auto instance = Get().find(proxy);
+	return instance ? instance->entry().link : QString();
+}
+
+QString TitleFor(const MTP::ProxyData &proxy) {
+	const auto instance = Get().find(proxy);
+	const auto title = instance
+		? TitleForSummary(instance->entry().summary)
+		: QString();
+	return title.isEmpty()
+		? u"%1:%2"_q.arg(proxy.host).arg(proxy.port)
+		: title;
+}
+
+QString StatusFor(const MTP::ProxyData &proxy) {
+	const auto instance = Get().find(proxy);
+	return instance ? instance->statusText() : QString();
+}
+
+void SetEntryActive(const MTP::ProxyData &proxy, bool active) {
+	Get().setActive(proxy, active);
+}
+
+rpl::producer<> StateChanges() {
+	return Get().stateChanges();
+}
+
+QString FormatSummary(const QString &summary) {
+	auto parts = SplitSummary(summary.trimmed());
+	parts.removeAll(QString());
+	return parts.join(u" · "_q);
+}
+
+ApplyResult SaveLink(const QString &link, const MTP::ProxyData &existing) {
+	return Get().saveLink(link, existing);
+}
+
+void CheckLink(const QString &link, Fn<void(CheckResult)> done) {
+	Get().checkLink(link, std::move(done));
+}
+
+QString Tr(const QString &ru, const QString &en) {
+	const auto russian = [](const QString &id) {
+		return id.startsWith(u"ru"_q, Qt::CaseInsensitive);
+	};
+	// Lang::Instance keeps an empty id until the user picks a language.
+	const auto &lang = Lang::GetInstance();
+	if (lang.id().isEmpty()) {
+		return russian(lang.systemLangCode()) ? ru : en;
+	}
+	return (russian(lang.id()) || russian(lang.baseId())) ? ru : en;
+}
+
+bool LooksLikeShareLink(const QString &text) {
+	const auto schemes = std::array{
+		u"vless://"_q,
+		u"vmess://"_q,
+		u"trojan://"_q,
+		u"ss://"_q,
+		u"socks://"_q,
+		u"hysteria2://"_q,
+		u"hy2://"_q,
+	};
+	const auto trimmed = text.trimmed();
+	for (const auto &scheme : schemes) {
+		if (trimmed.startsWith(scheme, Qt::CaseInsensitive)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+} // namespace Xraygram
