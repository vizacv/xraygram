+
+#include "xraygram/xraygram_core.h"
+#include "base/timer.h"
+#include "boxes/abstract_box.h"
+#include "core/application.h"
+#include "core/core_settings.h"
+#include "storage/localstorage.h"
+#include "ui/boxes/confirm_box.h"
+#include "ui/layers/generic_box.h"
+#include "ui/layers/show.h"
+#include "ui/vertical_list.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/checkbox.h"
+#include "ui/wrap/slide_wrap.h"
+#include "ui/wrap/vertical_layout.h"
+#include "ui/widgets/fields/input_field.h"
+#include "ui/widgets/labels.h"
+#include "window/window_controller.h"
+#include "styles/style_boxes.h"
+#include "styles/style_connection_box.h"
+#include "styles/style_layers.h"
+
+#include <QtGui/QClipboard>
+#include <QtGui/QGuiApplication>
+
+namespace Xraygram {
+namespace {
+
+base::weak_qptr<Ui::GenericBox> CurrentGate;
+
+[[nodiscard]] QString DirectWarningText() {
+	return Tr(
+		u"Xraygram подключится к Telegram без XRAY: провайдер увидит это "
+		"соединение, а там, где Telegram блокируют, связи не будет. "
+		"Вернуться к XRAY: Настройки → Продвинутые → Тип соединения."_q,
+		u"Xraygram will connect to Telegram without XRAY: your provider will "
+		"see this connection, and where Telegram is blocked it will not "
+		"work. To go back to XRAY: Settings → Advanced → Connection type."_q);
+}
+
+void ApplyCurrentProxy() {
+	auto &settings = Core::App().settings().proxy();
+	Core::App().setCurrentProxy(settings.selected(), settings.settings());
+	Local::writeSettings();
+}
+
+void ConfirmDirectImpl(std::shared_ptr<Ui::Show> show, Fn<void()> done) {
+	show->showBox(Ui::MakeConfirmBox({
+		.text = DirectWarningText(),
+		.confirmed = [=](Fn<void()> close) {
+			close();
+			done();
+		},
+		.confirmText = Tr(u"Подключиться напрямую"_q, u"Connect directly"_q),
+		.confirmStyle = &st::attentionBoxButton,
+		.title = Tr(u"Подключиться напрямую?"_q, u"Connect directly?"_q),
+	}));
+}
+
+void GateBox(not_null<Ui::GenericBox*> box, std::shared_ptr<Ui::Show> show) {
+	struct State {
+		base::Timer timer;
+		int checkId = 0;
+		bool closing = false;
+	};
+	const auto state = box->lifetime().make_state<State>();
+
+	box->setTitle(
+		Tr(u"Подключение через XRAY"_q, u"Connect through XRAY"_q));
+	box->setWidth(st::boxWideWidth);
+	box->setCloseByEscape(false);
+	box->setCloseByOutsideClick(false);
+
+	const auto saved = SavedEntries();
+	const auto clipboard = QGuiApplication::clipboard()->text().trimmed();
+	const auto clipboardLink = LooksLikeShareLink(clipboard)
+		? clipboard
+		: QString();
+	constexpr auto kNewLink = -1;
+
+	box->addRow(object_ptr<Ui::FlatLabel>(
+		box,
+		(saved.empty()
+			? Tr(
+				u"Xraygram подключается к Telegram только через ваш сервер "
+				"XRAY. Вставьте ссылку на него: vless://, vmess://, "
+				"trojan://, ss:// или hysteria2://. Пока ссылки нет, "
+				"Xraygram никуда не подключается."_q,
+				u"Xraygram connects to Telegram only through your XRAY "
+				"server. Paste its link: vless://, vmess://, trojan://, "
+				"ss:// or hysteria2://. Until there is a link, Xraygram "
+				"does not connect anywhere."_q)
+			: Tr(
+				u"Xraygram подключается к Telegram только через ваш сервер "
+				"XRAY. Выберите сохранённый сервер или вставьте новую "
+				"ссылку. До этого Xraygram никуда не подключается."_q,
+				u"Xraygram connects to Telegram only through your XRAY "
+				"server. Choose a saved server or paste a new link. Until "
+				"then Xraygram does not connect anywhere."_q)),
+		st::boxLabel));
+	Ui::AddSkip(box->verticalLayout());
+
+	const auto choice = std::make_shared<Ui::RadiobuttonGroup>(
+		(saved.empty() || !clipboardLink.isEmpty()) ? kNewLink : 0);
+	if (!saved.empty()) {
+		Ui::AddSubsectionTitle(
+			box->verticalLayout(),
+			rpl::single(Tr(u"Сохранённые серверы"_q, u"Saved servers"_q)));
+		for (auto i = 0, count = int(saved.size()); i != count; ++i) {
+			box->addRow(object_ptr<Ui::Radiobutton>(
+				box,
+				choice,
+				i,
+				u"XRAY · "_q + saved[i].label,
+				st::defaultBoxCheckbox));
+		}
+		box->addRow(object_ptr<Ui::Radiobutton>(
+			box,
+			choice,
+			kNewLink,
+			Tr(u"Новая ссылка"_q, u"New link"_q),
+			st::defaultBoxCheckbox));
+		Ui::AddSkip(box->verticalLayout());
+	}
+
+	const auto linkWrap = box->addRow(
+		object_ptr<Ui::SlideWrap<Ui::VerticalLayout>>(
+			box,
+			object_ptr<Ui::VerticalLayout>(box)),
+		style::margins());
+	const auto linkContent = linkWrap->entity();
+	const auto field = linkContent->add(
+		object_ptr<Ui::InputField>(
+			linkContent,
+			st::connectionXrayLinkField,
+			Ui::InputField::Mode::MultiLine,
+			rpl::single(u"vless://…"_q),
+			clipboardLink),
+		st::boxRowPadding);
+	field->setInputMethodHints(Qt::ImhUrlCharactersOnly
+		| Qt::ImhNoAutoUppercase
+		| Qt::ImhNoPredictiveText);
+	const auto status = linkContent->add(
+		object_ptr<Ui::FlatLabel>(
+			linkContent,
+			QString(),
+			st::boxDividerLabel),
+		st::boxRowPadding);
+	linkContent->add(
+		object_ptr<Ui::FlatLabel>(
+			linkContent,
+			Tr(
+				u"Ссылка на ваш сервер: vless://, vmess://, trojan://, ss:// "
+				"или hysteria2://. Если она скопирована, подставится сама."_q,
+				u"Link to your server: vless://, vmess://, trojan://, ss:// "
+				"or hysteria2://. If it is copied, it is filled in "
+				"automatically."_q),
+			st::boxDividerLabel),
+		st::boxRowPadding);
+	linkWrap->toggleOn(choice->value() | rpl::map([=](int value) {
+		return (value == kNewLink);
+	}), anim::type::instant);
+	choice->changes() | rpl::on_next([=](int value) {
+		if (value == kNewLink) {
+			field->setFocusFast();
+		}
+	}, field->lifetime());
+
+	const auto refresh = [=] {
+		const auto link = field->getLastText().trimmed();
+		const auto id = ++state->checkId;
+		if (link.isEmpty()) {
+			status->setText(QString());
+			return;
+		}
+		status->setText(Tr(u"Проверяю ссылку…"_q, u"Checking link…"_q));
+		CheckLink(link, crl::guard(box.get(), [=](CheckResult result) {
+			if (id != state->checkId) {
+				return;
+			}
+			status->setText(result.error.isEmpty()
+				? (Tr(u"Сервер: "_q, u"Server: "_q)
+					+ FormatSummary(result.summary))
+				: (Tr(u"Ошибка: "_q, u"Error: "_q) + result.error));
+		}));
+	};
+	state->timer.setCallback(refresh);
+	field->changes(
+	) | rpl::on_next([=] {
+		++state->checkId;
+		state->timer.callOnce(300);
+	}, field->lifetime());
+	refresh();
+
+	const auto connect = [=] {
+		const auto index = choice->current();
+		const auto useSaved = (index >= 0 && index < int(saved.size()));
+		const auto link = field->getLastText().trimmed();
+		if (!useSaved && link.isEmpty()) {
+			++state->checkId;
+			status->setText(Tr(
+				u"Ошибка: Вставьте ссылку на сервер"_q,
+				u"Error: Paste the server link"_q));
+			field->showError();
+			return;
+		}
+		const auto result = useSaved
+			? ActivateSaved(saved[index].proxy)
+			: SaveLink(link, MTP::ProxyData());
+		if (!result.proxy) {
+			if (useSaved) {
+				show->showToast(
+					Tr(u"Ошибка: "_q, u"Error: "_q) + result.error);
+				return;
+			}
+			++state->checkId;
+			status->setText(
+				Tr(u"Ошибка: "_q, u"Error: "_q) + result.error);
+			field->showError();
+			return;
+		}
+		auto &settings = Core::App().settings().proxy();
+		if (settings.indexInList(result.proxy) < 0) {
+			settings.addToList(result.proxy);
+		}
+		Core::App().setCurrentProxy(
+			result.proxy,
+			MTP::ProxyData::Settings::Enabled);
+		Local::writeSettings();
+		if (!result.error.isEmpty()) {
+			show->showToast(Tr(
+				u"XRAY сохранён, но пока не запустился: "_q,
+				u"XRAY saved but has not started yet: "_q) + result.error);
+		}
+		state->closing = true;
+		box->closeBox();
+	};
+	field->submits(
+	) | rpl::on_next([=] {
+		connect();
+	}, field->lifetime());
+	box->setFocusCallback([=] {
+		if (choice->current() == kNewLink) {
+			field->setFocusFast();
+		}
+	});
+	box->addButton(
+		rpl::single(Tr(u"Подключить"_q, u"Connect"_q)),
+		connect);
+
+	Ui::AddSkip(box->verticalLayout());
+	const auto direct = box->addRow(
+		object_ptr<Ui::LinkButton>(
+			box,
+			Tr(
+				u"Подключиться без XRAY (напрямую)"_q,
+				u"Connect without XRAY (direct)"_q),
+			st::boxLinkButton),
+		style::al_left);
+	direct->setClickedCallback([=] {
+		ConfirmDirectImpl(show, [=] {
+			AllowDirect();
+			ApplyCurrentProxy();
+			state->closing = true;
+			box->closeBox();
+		});
+	});
+
+	rpl::merge(
+		Core::App().proxyChanges() | rpl::to_empty,
+		Core::App().settings().proxy().connectionTypeChanges()
+	) | rpl::on_next([=] {
+		crl::on_main(box.get(), [=] {
+			if (!state->closing && !NetworkBlocked()) {
+				state->closing = true;
+				box->closeBox();
+			}
+		});
+	}, box->lifetime());
+}
+
+} // namespace
+
+void ConfirmDirectConnection(
+		std::shared_ptr<Ui::Show> show,
+		Fn<void()> confirmed) {
+	ConfirmDirectImpl(std::move(show), std::move(confirmed));
+}
+
+void ShowGateIfNeeded() {
+	if (Core::Quitting() || !NetworkBlocked() || CurrentGate) {
+		return;
+	}
+	const auto window = Core::App().activePrimaryWindow();
+	if (!window) {
+		return;
+	}
+	LOG(("Xraygram: network blocked, showing the XRAY gate (saved: %1)."
+		).arg(SavedEntries().size()));
+	const auto show = window->uiShow();
+	auto box = Box(GateBox, show);
+	const auto raw = box.data();
+	CurrentGate = raw;
+	raw->lifetime().add([] {
+		crl::on_main([] {
+			ShowGateIfNeeded();
+		});
+	});
+	show->showBox(std::move(box), Ui::LayerOption::KeepOther);
+}
+
+void RefreshGate() {
+	ApplyCurrentProxy();
+	ShowGateIfNeeded();
+}
+
+} // namespace Xraygram
