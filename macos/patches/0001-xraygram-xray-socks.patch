+
+namespace Xraygram {
+namespace {
+
+// Keep in sync with the list in macos/decisions.md (FEAT-19, PAR-20).
+[[nodiscard]] base::flat_set<ushort> CollectBrandKeys() {
+	return {
+		tr::lng_open_from_tray.base,
+		tr::lng_quit_from_tray.base,
+		tr::lng_tray_icon_text.base,
+		tr::lng_error_start_minimized_passcoded.base,
+		tr::lng_proxy_unsupported.base,
+		tr::lng_intro_about.base,
+		tr::lng_update_telegram.base,
+		tr::lng_sure_save_language.base,
+		tr::lng_settings_auto_start.base,
+		tr::lng_settings_passcode_lock_app.base,
+		tr::lng_settings_use_touchid_about.base,
+		tr::lng_settings_use_applewatch_about.base,
+		tr::lng_settings_use_systempwd_about.base,
+		tr::lng_theme_no_desktop.base,
+		tr::lng_local_storage_device_telegram.base,
+		tr::lng_local_storage_device_usage.base,
+		tr::lng_passcode_about.base,
+		tr::lng_passcode_about2.base,
+		tr::lng_passcode_about3.base,
+		tr::lng_passcode_unlock_about.base,
+		tr::lng_bad_photo.base,
+		tr::lng_bad_video.base,
+		tr::lng_message_unsupported.base,
+		tr::lng_unsupported_message_text.base,
+		tr::lng_unsupported_block_text.base,
+		tr::lng_stories_unsupported.base,
+		tr::lng_new_version_wrap.base,
+		tr::lng_bot_share_location_unavailable.base,
+		tr::lng_call_status_group_invite.base,
+		tr::lng_call_box_about.base,
+		tr::lng_confcall_join_text.base,
+		tr::lng_group_call_mac_access.base,
+		tr::lng_group_call_mac_input.base,
+		tr::lng_group_call_mac_accessibility.base,
+		tr::lng_group_call_mac_screencast_access.base,
+		tr::lng_group_call_mac_recording.base,
+		tr::lng_no_mic_permission.base,
+		tr::lng_screen_reader_bar_text.base,
+		tr::lng_screen_reader_confirm_text.base,
+		tr::lng_outdated_soon.base,
+		tr::lng_outdated_now.base,
+		tr::lng_wallet_protection_open_warning_lock.base,
+	};
+}
+
+} // namespace
+
+bool IsBrandKey(ushort key) {
+	static const auto keys = CollectBrandKeys();
+	return keys.contains(key);
+}
+
+QString BrandValue(const QString &value) {
+	if (!value.contains(u"Telegram"_q) && !value.contains(u"Телеграм"_q)) {
+		return value;
+	}
+	static const auto expression = QRegularExpression(
+		u"Telegram Desktop|\\bTelegram\\b|Телеграмм?[а-яё]*"_q);
+	auto result = value;
+	result.replace(expression, u"Xraygram"_q);
+	return result;
+}
+
+QImage BrandImage(const QString &name) {
+	return QImage(u":/xraygram/"_q + name);
+}
+
+} // namespace Xraygram
