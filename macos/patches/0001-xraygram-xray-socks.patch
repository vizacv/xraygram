+	}, _xrayLink->lifetime());
+	refreshXrayStatus();
+}
+
+void ProxyBox::refreshXrayStatus() {
+	const auto link = _xrayLink->getLastText().trimmed();
+	const auto id = ++_xrayCheckId;
+	if (link.isEmpty()) {
+		_xrayStatus->setText(QString());
+		return;
+	}
+	_xrayStatus->setText(
+		Xraygram::Tr(u"Проверяю ссылку…"_q, u"Checking link…"_q));
+	Xraygram::CheckLink(link, crl::guard(this, [=](
+			Xraygram::CheckResult result) {
+		if (id != _xrayCheckId) {
+			return;
+		}
+		_xrayStatus->setText(result.error.isEmpty()
+			? (Xraygram::Tr(u"Сервер: "_q, u"Server: "_q)
+				+ Xraygram::FormatSummary(result.summary))
+			: (Xraygram::Tr(u"Ошибка: "_q, u"Error: "_q) + result.error));
+	}));
+}
+
+ProxyData ProxyBox::collectXrayData() {
+	const auto link = _xrayLink->getLastText().trimmed();
+	if (link.isEmpty()) {
+		++_xrayCheckId;
+		_xrayStatus->setText(Xraygram::Tr(
+			u"Ошибка: Вставьте ссылку на сервер"_q,
+			u"Error: Paste the server link"_q));
+		_xrayLink->showError();
+		return ProxyData();
+	}
+	const auto result = Xraygram::SaveLink(link, _xrayExisting);
+	if (result.proxy) {
+		_xrayExisting = result.proxy;
+	}
+	if (!result.error.isEmpty()) {
+		++_xrayCheckId;
+		_xrayStatus->setText(
+			Xraygram::Tr(u"Ошибка: "_q, u"Error: "_q) + result.error);
+		_xrayLink->showError();
+		return ProxyData();
+	}
+	return result.proxy;
+}
