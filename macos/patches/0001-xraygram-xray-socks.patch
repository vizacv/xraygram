+namespace Xraygram {
+
+void ShowLinkBox(
+		std::shared_ptr<Ui::Show> show,
+		LinkBoxCallbacks callbacks,
+		const QString &prefill) {
+	show->showBox(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(u"Xray (VLESS / Reality)"_q);
+		box->setWidth(st::boxWideWidth);
+
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			u"Вставьте ссылку vless:// (также vmess://, trojan://, "
+			"ss://, hysteria2://). Xraygram запустит встроенный xray "
+			"и подключится через него как через локальный SOCKS5."_q,
+			st::boxLabel));
+		Ui::AddSkip(box->verticalLayout());
+
+		const auto initial = prefill.isEmpty() ? CurrentLink() : prefill;
+		const auto field = box->addRow(object_ptr<Ui::InputField>(
+			box,
+			st::newGroupDescription,
+			Ui::InputField::Mode::MultiLine,
+			rpl::single(u"vless://…"_q),
+			initial));
+		Ui::AddSkip(box->verticalLayout());
+
+		const auto status = box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			StatusText(),
+			st::boxDividerLabel));
+
+		box->setFocusCallback([=] {
+			field->setFocusFast();
+		});
+
+		const auto save = [=] {
+			const auto result = SetLink(field->getLastText());
+			if (result.proxy && callbacks.applied) {
+				callbacks.applied(result.proxy);
+			}
+			if (!result.error.isEmpty()) {
+				if (!result.proxy) {
+					field->showError();
+				}
+				status->setText(u"Ошибка: "_q + result.error);
+				return;
+			}
+			show->showToast(u"Xray запущен: "_q + result.summary);
+			box->closeBox();
+		};
+		field->submits(
+		) | rpl::on_next([=] {
+			save();
+		}, field->lifetime());
+
+		box->addButton(rpl::single(u"Сохранить и подключить"_q), save);
+		box->addButton(tr::lng_cancel(), [=] {
+			box->closeBox();
+		});
+		if (Configured()) {
+			box->addLeftButton(rpl::single(u"Удалить"_q), [=] {
+				const auto was = RemoveLink();
+				if (callbacks.removed) {
+					callbacks.removed(was);
+				}
+				box->closeBox();
+			}, st::attentionBoxButton);
+		}
+	}));
+}
+
+} // namespace Xraygram
