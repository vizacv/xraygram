+# Xraygram (FEAT-19): brand images from the repository branding/ folder,
+# compiled into the app resources as :/xraygram/*. No binaries in the patch.
+set(XRAYGRAM_BRANDING_DIR "" CACHE PATH "Xraygram: branding/ folder with logos and tray masks.")
+if (XRAYGRAM_BRANDING_DIR)
+    set(xraygram_brand_files
+        "logo.png=macos/xraygram-macos-1024.png"
+        "logo_square.png=xraygram-icon-1024.png"
+        "tray.png=macos/tray/mac_tray_icon.png"
+        "tray@2x.png=macos/tray/mac_tray_icon@2x.png"
+        "tray@3x.png=macos/tray/mac_tray_icon@3x.png"
+    )
+    set(xraygram_brand_entries "")
+    set(xraygram_brand_sources)
+    foreach (pair ${xraygram_brand_files})
+        string(REPLACE "=" ";" pair_list "${pair}")
+        list(GET pair_list 0 brand_alias)
+        list(GET pair_list 1 brand_path)
+        set(brand_source "${XRAYGRAM_BRANDING_DIR}/${brand_path}")
+        if (NOT EXISTS "${brand_source}")
+            message(FATAL_ERROR "Xraygram: missing branding file ${brand_source}")
+        endif()
+        file(RELATIVE_PATH brand_relative "${CMAKE_CURRENT_BINARY_DIR}" "${brand_source}")
+        string(APPEND xraygram_brand_entries "    <file alias=\"${brand_alias}\">${brand_relative}</file>\n")
+        list(APPEND xraygram_brand_sources "${brand_source}")
+    endforeach()
+    set(xraygram_brand_qrc "${CMAKE_CURRENT_BINARY_DIR}/xraygram_branding.qrc")
+    file(CONFIGURE OUTPUT "${xraygram_brand_qrc}" CONTENT
+"<RCC>\n  <qresource prefix=\"/xraygram\">\n${xraygram_brand_entries}  </qresource>\n</RCC>\n" @ONLY)
+    set_source_files_properties("${xraygram_brand_qrc}" PROPERTIES
+        QRC_GENERATED_FROM "${xraygram_brand_sources}")
+    target_sources(Telegram PRIVATE "${xraygram_brand_qrc}")
+endif()
+
 target_prepare_qrc(Telegram)
 
