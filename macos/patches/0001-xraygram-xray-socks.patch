+/*
+This file is part of Xraygram, a fork of Telegram Desktop.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#include "xraygram/xraygram_core.h"
+
+#include "core/application.h"
+#include "core/core_settings.h"
+#include "settings.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QElapsedTimer>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QProcess>
+#include <QtCore/QProcessEnvironment>
+#include <QtCore/QRandomGenerator>
+#include <QtCore/QTimer>
+#include <QtNetwork/QHostAddress>
+#include <QtNetwork/QTcpServer>
+
+namespace Xraygram {
+namespace {
+
+constexpr auto kHost = "127.0.0.1";
+constexpr auto kStartTimeout = 5000;
+constexpr auto kCheckTimeout = 5000;
+constexpr auto kStopTimeout = 2000;
+constexpr auto kRestartDelay = crl::time(3000);
+constexpr auto kMaxRestartDelay = crl::time(120000);
+constexpr auto kStableRunTime = crl::time(60000);
+constexpr auto kMaxTailSize = 4096;
+
+struct Config {
+	QString link;
+	int port = 0;
+	QString password;
+};
+
+[[nodiscard]] QString ConfigPath() {
+	return cWorkingDir() + u"tdata/xraygram.json"_q;
+}
+
+[[nodiscard]] QString HelperPath() {
+	const auto custom = qEnvironmentVariable("XRAYGRAM_CORE");
+	return custom.isEmpty()
+		? (QCoreApplication::applicationDirPath() + u"/xraygram-core"_q)
+		: custom;
+}
+
+[[nodiscard]] Config ReadConfig() {
+	auto file = QFile(ConfigPath());
+	if (!file.open(QIODevice::ReadOnly)) {
+		return {};
+	}
+	const auto object = QJsonDocument::fromJson(file.readAll()).object();
+	return {
+		.link = object.value(u"link"_q).toString().trimmed(),
+		.port = object.value(u"port"_q).toInt(),
+		.password = object.value(u"password"_q).toString(),
+	};
+}
+
+bool WriteConfig(const Config &config) {
+	QDir().mkpath(cWorkingDir() + u"tdata"_q);
+	const auto path = ConfigPath();
+	if (config.link.isEmpty()) {
+		return !QFile::exists(path) || QFile::remove(path);
+	}
+	auto file = QFile(path);
+	if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		LOG(("Xraygram Error: could not write %1").arg(path));
+		return false;
+	}
+	file.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+	auto object = QJsonObject();
+	object.insert(u"link"_q, config.link);
+	object.insert(u"port"_q, config.port);
+	object.insert(u"password"_q, config.password);
+	file.write(QJsonDocument(object).toJson(QJsonDocument::Indented));
+	return true;
+}
+
+[[nodiscard]] bool PortFree(int port) {
+	if (port <= 0 || port > 65535) {
+		return false;
+	}
+	auto server = QTcpServer();
+	const auto result = server.listen(QHostAddress::LocalHost, quint16(port));
+	server.close();
+	return result;
+}
+
+[[nodiscard]] int PickFreePort() {
+	auto server = QTcpServer();
+	if (!server.listen(QHostAddress::LocalHost, 0)) {
+		return 0;
+	}
+	const auto result = int(server.serverPort());
+	server.close();
+	return result;
+}
+
+[[nodiscard]] QString RandomPassword() {
+	auto result = QString();
+	auto *generator = QRandomGenerator::system();
+	for (auto i = 0; i != 4; ++i) {
+		result += QString::number(generator->generate64(), 16);
+	}
+	return result;
+}
+
+[[nodiscard]] MTP::ProxyData ProxyFor(const Config &config) {
+	if (config.link.isEmpty() || config.port <= 0) {
+		return {};
+	}
+	auto result = MTP::ProxyData();
+	result.type = MTP::ProxyData::Type::Socks5;
+	result.host = QString::fromLatin1(kHost);
+	result.port = uint32(config.port);
+	result.user = QString::fromLatin1(kSocksUser);
+	result.password = config.password;
+	return result;
+}
+
+[[nodiscard]] QString FirstLine(const QByteArray &data) {
+	const auto text = QString::fromUtf8(data).trimmed();
+	const auto index = text.indexOf('\n');
+	return (index < 0) ? text : text.mid(0, index).trimmed();
+}
+
+[[nodiscard]] QString StripPrefix(QString text, const QString &prefix) {
+	return text.startsWith(prefix) ? text.mid(prefix.size()).trimmed() : text;
+}
+
+class Manager final {
+public:
+	Manager();
+
+	void start();
+	void shutdown();
+	void ensureRunning();
+
+	[[nodiscard]] bool configured() const;
+	[[nodiscard]] bool running() const;
+	[[nodiscard]] QString link() const;
+	[[nodiscard]] MTP::ProxyData proxy() const;
+	[[nodiscard]] QString statusText() const;
+
+	[[nodiscard]] ApplyResult setLink(const QString &link);
+	MTP::ProxyData removeLink();
+
+private:
+	[[nodiscard]] QString check(const QString &link, QString *summary);
+	bool launch();
+	bool tryLaunch();
+	void stop();
+	bool ensurePort();
+	void restart();
+	void readLogs();
+	void processFinished(int exitCode);
+	void noteFailure();
+	void scheduleRestart();
+	[[nodiscard]] crl::time backoff() const;
+
+	std::unique_ptr<QObject> _guard;
+	Config _config;
+	std::unique_ptr<QProcess> _process;
+	QByteArray _tail;
+	QString _summary;
+	QString _lastError;
+	bool _ready = false;
+	bool _restartScheduled = false;
+	int _failures = 0;
+	crl::time _startedAt = 0;
+	crl::time _nextAttemptAt = 0;
+
+};
+
+Manager::Manager() : _guard(std::make_unique<QObject>()) {
+}
+
+void Manager::start() {
+	_config = ReadConfig();
+	if (!configured()) {
+		return;
+	}
+	ensurePort();
+	launch();
+}
+
+void Manager::shutdown() {
+	stop();
+	_guard = nullptr;
+}
+
+void Manager::ensureRunning() {
+	if (configured()
+		&& !running()
+		&& !_restartScheduled
+		&& crl::now() >= _nextAttemptAt) {
+		launch();
+	}
+}
+
+void Manager::restart() {
+	if (!configured() || running()) {
+		return;
+	}
+	const auto selectedChanged = ensurePort();
+	if (!launch()) {
+		scheduleRestart();
+	}
+	if (selectedChanged) {
+		auto &settings = Core::App().settings().proxy();
+		Core::App().setCurrentProxy(proxy(), settings.settings());
+	}
+}
+
+crl::time Manager::backoff() const {
+	auto result = kRestartDelay;
+	for (auto i = 1; i < _failures && result < kMaxRestartDelay; ++i) {
+		result *= 2;
+	}
+	return std::min(result, kMaxRestartDelay);
+}
+
+void Manager::noteFailure() {
+	++_failures;
+	_nextAttemptAt = crl::now() + backoff();
+}
+
+bool Manager::configured() const {
+	return !_config.link.isEmpty() && _config.port > 0;
+}
+
+bool Manager::running() const {
+	return _process
+		&& _ready
+		&& (_process->state() == QProcess::Running);
+}
+
+QString Manager::link() const {
+	return _config.link;
+}
+
+MTP::ProxyData Manager::proxy() const {
+	return ProxyFor(_config);
+}
+
+QString Manager::statusText() const {
+	if (!configured()) {
+		return u"Xray не настроен."_q;
+	} else if (running()) {
+		return u"Xray работает: %1:%2 → %3"_q
+			.arg(QString::fromLatin1(kHost))
+			.arg(_config.port)
+			.arg(_summary);
+	} else if (!_lastError.isEmpty()) {
+		return u"Xray не запущен: %1"_q.arg(_lastError);
+	}
+	return u"Xray не запущен."_q;
+}
+
+QString Manager::check(const QString &link, QString *summary) {
+	auto process = QProcess();
+	process.setProgram(HelperPath());
+	process.setArguments({ u"check"_q });
+	process.start();
+	if (!process.waitForStarted(kCheckTimeout)) {
+		return u"не удалось запустить %1: %2"_q
+			.arg(HelperPath(), process.errorString());
+	}
+	process.write(link.toUtf8());
+	process.closeWriteChannel();
+	if (!process.waitForFinished(kCheckTimeout)) {
+		process.kill();
+		process.waitForFinished(kStopTimeout);
+		return u"xraygram-core check: таймаут"_q;
+	}
+	const auto out = FirstLine(process.readAllStandardOutput());
+	if (process.exitStatus() == QProcess::NormalExit
+		&& process.exitCode() == 0
+		&& out.startsWith(u"OK"_q)) {
+		if (summary) {
+			*summary = StripPrefix(out, u"OK"_q);
+		}
+		return QString();
+	}
+	const auto error = FirstLine(process.readAllStandardError());
+	return error.isEmpty()
+		? u"ссылка не распознана"_q
+		: StripPrefix(error, u"ERROR"_q);
+}
+
+bool Manager::ensurePort() {
+	if (PortFree(_config.port)) {
+		return false;
+	}
+	const auto was = ProxyFor(_config);
+	_config.port = PickFreePort();
+	WriteConfig(_config);
+	const auto now = ProxyFor(_config);
+	LOG(("Xraygram: port busy, moving SOCKS5 inbound to %1"
+		).arg(_config.port));
+
+	auto &settings = Core::App().settings().proxy();
+	const auto selectedChanged = (settings.selected() == was);
+	if (selectedChanged) {
+		settings.setSelected(now);
+	}
+	if (!settings.replaceInList(was, now) && selectedChanged) {
+		settings.addToList(now);
+	}
+	Core::App().saveSettingsDelayed();
+	return selectedChanged;
+}
+
+bool Manager::launch() {
+	if (tryLaunch()) {
+		_startedAt = crl::now();
+		return true;
+	}
+	noteFailure();
+	return false;
+}
+
+bool Manager::tryLaunch() {
+	stop();
+	_lastError = QString();
+	if (!configured()) {
+		return false;
+	}
+	const auto path = HelperPath();
+	if (!QFile::exists(path)) {
+		_lastError = u"не найден %1"_q.arg(path);
+		LOG(("Xraygram Error: %1").arg(_lastError));
+		return false;
+	}
+
+	_process = std::make_unique<QProcess>();
+	const auto raw = _process.get();
+	auto environment = QProcessEnvironment::systemEnvironment();
+	environment.insert(
+		u"XRAYGRAM_SOCKS_USER"_q,
+		QString::fromLatin1(kSocksUser));
+	environment.insert(u"XRAYGRAM_SOCKS_PASS"_q, _config.password);
+	raw->setProcessEnvironment(environment);
+	raw->setProgram(path);
+	raw->setArguments({
+		u"run"_q,
+		u"-listen"_q,
+		u"%1:%2"_q.arg(QString::fromLatin1(kHost)).arg(_config.port),
+	});
+	_ready = false;
+	_tail = QByteArray();
+	raw->start();
+	if (!raw->waitForStarted(kStartTimeout)) {
+		_lastError = raw->errorString();
+		LOG(("Xraygram Error: start failed: %1").arg(_lastError));
+		_process = nullptr;
+		return false;
+	}
+	raw->write(_config.link.toUtf8());
+	raw->closeWriteChannel();
+
+	auto timer = QElapsedTimer();
+	timer.start();
+	auto out = QByteArray();
+	while (!out.contains("READY")) {
+		const auto left = kStartTimeout - timer.elapsed();
+		if (left <= 0 || !raw->waitForReadyRead(int(left))) {
+			break;
+		}
+		out += raw->readAllStandardOutput();
+	}
+	if (!out.contains("READY")) {
+		const auto error = FirstLine(raw->readAllStandardError());
+		_lastError = error.isEmpty()
+			? u"xraygram-core не ответил"_q
+			: StripPrefix(error, u"ERROR"_q);
+		LOG(("Xraygram Error: %1").arg(_lastError));
+		stop();
+		return false;
+	}
+	const auto ready = QString::fromUtf8(out);
+	const auto index = ready.indexOf(u"READY"_q);
+	_summary = FirstLine(ready.mid(index + 5).toUtf8());
+	_ready = true;
+	LOG(("Xraygram: xray started on %1:%2 (%3)"
+		).arg(QString::fromLatin1(kHost)
+		).arg(_config.port
+		).arg(_summary));
+
+	QObject::connect(
+		raw,
+		&QProcess::readyReadStandardOutput,
+		_guard.get(),
+		[=] { readLogs(); });
+	QObject::connect(
+		raw,
+		&QProcess::readyReadStandardError,
+		_guard.get(),
+		[=] { readLogs(); });
+	QObject::connect(
+		raw,
+		&QProcess::finished,
+		_guard.get(),
+		[=](int exitCode, QProcess::ExitStatus) {
+			processFinished(exitCode);
+		});
+	if (raw->state() != QProcess::Running) {
+		_startedAt = crl::now();
+		processFinished(raw->exitCode());
+		return true;
+	}
+	return true;
+}
+
+void Manager::readLogs() {
+	if (!_process) {
+		return;
+	}
+	const auto data = _process->readAllStandardOutput()
+		+ _process->readAllStandardError();
+	if (data.isEmpty()) {
+		return;
+	}
+	_tail = (_tail + data).right(kMaxTailSize);
+	for (const auto &line : data.split('\n')) {
+		const auto trimmed = line.trimmed();
+		if (!trimmed.isEmpty()) {
+			DEBUG_LOG(("Xray: %1").arg(QString::fromUtf8(trimmed)));
+		}
+	}
+}
+
+void Manager::processFinished(int exitCode) {
+	readLogs();
+	const auto tail = QString::fromUtf8(_tail).trimmed();
+	_lastError = u"xray завершился (код %1)"_q.arg(exitCode);
+	LOG(("Xraygram Error: %1, log tail: %2").arg(_lastError, tail));
+	_ready = false;
+	if (_process) {
+		_process->disconnect(_guard.get());
+		_process.release()->deleteLater();
+	}
+	if (crl::now() - _startedAt >= kStableRunTime) {
+		_failures = 0;
+	}
+	noteFailure();
+	scheduleRestart();
+}
+
+void Manager::scheduleRestart() {
+	if (!configured() || _restartScheduled || !_guard) {
+		return;
+	}
+	_restartScheduled = true;
+	QTimer::singleShot(int(backoff()), _guard.get(), [=] {
+		_restartScheduled = false;
+		restart();
+	});
+}
+
+void Manager::stop() {
+	_ready = false;
+	auto process = base::take(_process);
+	if (!process) {
+		return;
+	}
+	process->disconnect(_guard.get());
+	if (process->state() != QProcess::NotRunning) {
+		process->terminate();
+		if (!process->waitForFinished(kStopTimeout)) {
+			process->kill();
+			process->waitForFinished(kStopTimeout);
+		}
+	}
+}
+
+ApplyResult Manager::setLink(const QString &link) {
+	const auto trimmed = link.trimmed();
+	if (trimmed.isEmpty()) {
+		return { .error = u"пустая ссылка"_q };
+	}
+	auto summary = QString();
+	if (const auto error = check(trimmed, &summary); !error.isEmpty()) {
+		return { .error = error };
+	}
+	stop();
+	_failures = 0;
+	_nextAttemptAt = 0;
+	_config.link = trimmed;
+	if (_config.password.isEmpty()) {
+		_config.password = RandomPassword();
+	}
+	if (!PortFree(_config.port)) {
+		_config.port = PickFreePort();
+	}
+	if (_config.port <= 0) {
+		return { .error = u"нет свободного локального порта"_q };
+	}
+	if (!WriteConfig(_config)) {
+		return { .error = u"не удалось сохранить %1"_q.arg(ConfigPath()) };
+	}
+	if (!launch() || !running()) {
+		return { .proxy = proxy(), .error = _lastError };
+	}
+	return { .proxy = proxy(), .summary = _summary };
+}
+
+MTP::ProxyData Manager::removeLink() {
+	const auto result = proxy();
+	stop();
+	_config.link = QString();
+	WriteConfig(_config);
+	_summary = QString();
+	_lastError = QString();
+	return result;
+}
+
+[[nodiscard]] Manager &Instance() {
+	static auto result = Manager();
+	return result;
+}
+
+} // namespace
+
+void Start() {
+	Instance().start();
+}
+
+void Shutdown() {
+	Instance().shutdown();
+}
+
+void EnsureRunning() {
+	Instance().ensureRunning();
+}
+
+bool IsXrayProxy(const MTP::ProxyData &proxy) {
+	return (proxy.type == MTP::ProxyData::Type::Socks5)
+		&& (proxy.host == QString::fromLatin1(kHost))
+		&& (proxy.user == QString::fromLatin1(kSocksUser));
+}
+
+bool Configured() {
+	return Instance().configured();
+}
+
+bool Running() {
+	return Instance().running();
+}
+
+QString CurrentLink() {
+	return Instance().link();
+}
+
+MTP::ProxyData CurrentProxy() {
+	return Instance().proxy();
+}
+
+QString StatusText() {
+	return Instance().statusText();
+}
+
+ApplyResult SetLink(const QString &link) {
+	return Instance().setLink(link);
+}
+
+MTP::ProxyData RemoveLink() {
+	return Instance().removeLink();
+}
+
+bool LooksLikeShareLink(const QString &text) {
+	const auto schemes = std::array{
+		u"vless://"_q,
+		u"vmess://"_q,
+		u"trojan://"_q,
+		u"ss://"_q,
+		u"socks://"_q,
+		u"hysteria2://"_q,
+		u"hy2://"_q,
+	};
+	const auto trimmed = text.trimmed();
+	for (const auto &scheme : schemes) {
+		if (trimmed.startsWith(scheme, Qt::CaseInsensitive)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+} // namespace Xraygram
