+bool ProxiesBoxController::deletionLeavesDirect(
+		const base::flat_set<int> &ids) const {
+	if (!_settings.isEnabled()
+		|| !Xraygram::IsXrayProxy(_settings.selected())) {
+		return false;
+	}
+	auto removesSelected = false;
+	for (const auto &item : _list) {
+		if (item.deleted) {
+			continue;
+		} else if (ids.contains(item.id)) {
+			if (item.data == _settings.selected()) {
+				removesSelected = true;
+			}
+		} else if (Xraygram::IsXrayProxy(item.data)) {
+			return false;
+		}
+	}
+	return removesSelected;
+}
+
+void ProxiesBoxController::confirmDeletion(
+		const base::flat_set<int> &ids,
+		Fn<void()> done) {
+	if (!deletionLeavesDirect(ids) || !_show) {
