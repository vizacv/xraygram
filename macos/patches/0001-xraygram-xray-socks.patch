+void ShowXrayServerQrBox(
+		std::shared_ptr<Ui::Show> show,
+		const QString &title,
+		const QString &link) {
+	show->showBox(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(title);
+		const auto qr = ProxyQrTile(
+			link,
+			st::boxWidth
+				- st::boxRowPadding.left()
+				- st::boxRowPadding.right());
+		const auto size = qr.width() / style::DevicePixelRatio();
+		const auto height = st::inviteLinkQrSkip * 2 + size;
+		const auto container = box->addRow(
+			object_ptr<Ui::BoxContentDivider>(box, height),
+			st::inviteLinkQrMargin);
+		const auto image = Ui::CreateChild<Ui::RpWidget>(container);
+		image->resize(size, size);
+		image->paintRequest(
+		) | rpl::on_next([=] {
+			QPainter(image).drawImage(QRect(0, 0, size, size), qr);
+		}, image->lifetime());
+		container->widthValue(
+		) | rpl::on_next([=](int width) {
+			image->move((width - size) / 2, st::inviteLinkQrSkip);
+		}, image->lifetime());
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			Xraygram::Tr(
+				u"Отсканируйте камерой телефона, затем вставьте ссылку в "
+				"Xraygram"_q,
+				u"Scan with a phone camera, then paste the link into "
+				"Xraygram"_q),
+			st::boxDividerLabel));
+
+		box->addButton(
+			rpl::single(Xraygram::Tr(u"Закрыть"_q, u"Close"_q)),
+			[=] { box->closeBox(); });
+		box->addLeftButton(
+			rpl::single(
+				Xraygram::Tr(u"Копировать ссылку"_q, u"Copy link"_q)),
+			[=] {
+				QGuiApplication::clipboard()->setText(link);
+				show->showToast({
+					.text = {
+						Xraygram::Tr(
+							u"Ссылка скопирована"_q,
+							u"Link copied"_q),
+					},
+					.iconLottie = u"toast/copy"_q,
+					.iconLottieSize = st::toastLottieIconSize,
+				});
+			});
+	}));
+}
+
+void ShareXrayServer(
+		std::shared_ptr<Ui::Show> show,
+		const ProxyData &proxy) {
+	const auto link = Xraygram::LinkFor(proxy);
+	if (link.isEmpty()) {
+		return;
+	}
+	const auto title = u"XRAY · "_q + Xraygram::TitleFor(proxy);
+	show->showBox(Ui::MakeConfirmBox({
+		.text = Xraygram::Tr(
+			u"Кто получит эту ссылку, сможет пользоваться вашим сервером "
+			"XRAY. Отправляйте её только тем, кому доверяете."_q,
+			u"Anyone who gets this link can use your XRAY server. Send it "
+			"only to people you trust."_q),
+		.confirmed = [=](Fn<void()> close) {
+			close();
+			ShowXrayServerQrBox(show, title, link);
+		},
+		.confirmText = Xraygram::Tr(u"Показать"_q, u"Show"_q),
+		.title = Xraygram::Tr(
+			u"Поделиться сервером?"_q,
+			u"Share server?"_q),
+	}));
+}
