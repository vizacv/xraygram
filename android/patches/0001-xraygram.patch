+package org.telegram.utils.proxy;
+
+import android.app.Activity;
+import android.content.DialogInterface;
+import android.os.SystemClock;
+import android.widget.TextView;
+
+import org.telegram.messenger.SharedConfig;
+import org.telegram.messenger.voip.NativeInstance;
+import org.telegram.ui.ActionBar.AlertDialog;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+
+import static org.telegram.utils.proxy.XrayTransport.str;
+
+/**
+ * Xraygram: calls with an active XRAY entry (FEAT-04).
+ *
+ * 1:1 calls: only the call versions whose implementation goes through the tgcalls SOCKS5 patch are offered/accepted —
+ * InstanceV2Impl (7, 8, 9, 12, 13) and InstanceV2ReferenceImpl (10, 11). Excluded: InstanceV2PumpImpl 18/19 (no proxy
+ * support at all) and v1 InstanceImpl 2.7.7/5.0.0 (its TURN over TCP would ignore the SOCKS5 proxy: libwebrtc has no
+ * SOCKS adapter any more). A call that cannot go through xray fails instead of going direct.
+ *
+ * Group calls, video chats, conferences, broadcasts are not proxied: a "Without XRAY" confirmation comes first.
+ */
+public final class XrayCalls {
+
+    private static final HashSet<String> PROXY_VERSIONS = new HashSet<>(Arrays.asList(
+            "7.0.0", "8.0.0", "9.0.0", "10.0.0", "11.0.0", "12.0.0", "13.0.0"));
+
+    private static long confirmedUntil;
+
+    private XrayCalls() {
+    }
+
+    /** An XRAY entry is selected and the proxy is on. */
+    public static boolean xrayActive() {
+        final SharedConfig.ProxyInfo current = SharedConfig.currentProxy;
+        return SharedConfig.isProxyEnabled() && current != null && current.settings.getType() == ProxySettings.Type.XRAY;
+    }
+
+    /** Versions for phone.requestCall / acceptCall / confirmCall. */
+    public static String[] versions() {
+        final String[] all = NativeInstance.getAllVersions();
+        if (!xrayActive() || all == null) {
+            return all;
+        }
+        final ArrayList<String> result = new ArrayList<>();
+        for (String version : all) {
+            if (PROXY_VERSIONS.contains(version)) {
+                result.add(version);
+            }
+        }
+        return result.toArray(new String[0]);
+    }
+
+    /** May a call of this version be started now? (false = would bypass xray) */
+    public static boolean versionAllowed(String version) {
+        return !xrayActive() || PROXY_VERSIONS.contains(version);
+    }
+
+    /**
+     * Before a group call / video chat / conference / broadcast with an active XRAY entry.
+     * @return true if the dialog was shown (the caller returns; {@code proceed} runs on "Continue").
+     */
+    public static boolean confirmWithoutXray(Activity activity, Runnable proceed) {
+        return confirmWithoutXray(activity, proceed, null);
+    }
+
+    /** Same, {@code onCancel} runs on "Cancel" (e.g. decline a conference invite, hang up a migrated call). */
+    public static boolean confirmWithoutXray(Activity activity, Runnable proceed, Runnable onCancel) {
+        if (activity == null || !xrayActive() || SystemClock.elapsedRealtime() < confirmedUntil) {
+            return false;
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(activity);
+        builder.setTitle(str("Без XRAY", "Without XRAY"));
+        builder.setMessage(str(
+                "Групповые звонки, видеочаты и конференции пока идут напрямую, без XRAY: провайдер увидит соединение с серверами Telegram, а при блокировке звонок может не соединиться.\n\nСообщения и звонки один на один по-прежнему идут через XRAY.",
+                "Group calls, video chats and conferences currently go directly, without XRAY: your provider will see a connection to Telegram servers, and where Telegram is blocked the call may not connect.\n\nMessages and one-on-one calls still go through XRAY."));
+        builder.setPositiveButton(str("Продолжить", "Continue"), (d, w) -> {
+            confirmedUntil = SystemClock.elapsedRealtime() + 10_000; // the same entry may re-enter itself (hang up → join)
+            proceed.run();
+        });
+        builder.setNegativeButton(str("Отмена", "Cancel"), (d, w) -> {
+            if (onCancel != null) {
+                onCancel.run();
+            }
+        });
+        AlertDialog dialog = builder.create();
+        if (onCancel != null) {
+            dialog.setCanceledOnTouchOutside(false);
+            dialog.setCancelable(false);
+        }
+        dialog.show();
+        return true;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayGate.java b/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayGate.java
new file mode 100644
index 000000000..a20a5518a
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayGate.java
@@ -0,0 +1,242 @@
+package org.telegram.utils.proxy;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.text.TextUtils;
+
+import org.json.JSONArray;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.SharedConfig;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.LaunchActivity;
+import org.telegram.ui.XrayGateActivity;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.LinkedHashSet;
+
+/**
+ * Xraygram: "connect through XRAY" gate (same rules on all platforms, see macos/decisions.md, MAC-05).
+ *
+ * Blocked = no XRAY entry in the proxy list and the user has not explicitly chosen "connect directly".
+ * While blocked the client sends nothing towards Telegram: every account gets a black-hole SOCKS5
+ * (127.0.0.1:1, connection refused locally) instead of its proxy settings, and the DNS/DoH fallbacks
+ * are not started. Saved proxy settings are not touched: the block is applied on top of them.
+ */
+public final class XrayGate {
+
+    /** Black-hole proxy: nobody listens on port 1, the connect fails locally. */
+    public static final String BLACKHOLE_ADDRESS = "127.0.0.1";
+    public static final int BLACKHOLE_PORT = 1;
+
+    private static final String PREF_DIRECT_ALLOWED = "xraygram_direct_allowed";
+    private static final String PREF_SAVED_LINKS = "xraygram_saved_links";
+
+    private XrayGate() {
+    }
+
+    private static SharedPreferences prefs() {
+        return MessagesController.getGlobalMainSettings();
+    }
+
+    public static boolean isDirectAllowed() {
+        try {
+            return prefs().getBoolean(PREF_DIRECT_ALLOWED, false);
+        } catch (Throwable e) {
+            return false;
+        }
+    }
+
+    public static void setDirectAllowed(boolean value) {
+        if (isDirectAllowed() != value) {
+            prefs().edit().putBoolean(PREF_DIRECT_ALLOWED, value).commit();
+        }
+    }
+
+    public static boolean isXray(SharedConfig.ProxyInfo info) {
+        return info != null && info.settings.getType() == ProxySettings.Type.XRAY;
+    }
+
+    public static boolean hasXrayEntries() {
+        try {
+            if (ApplicationLoader.applicationContext == null) {
+                return false;
+            }
+            SharedConfig.loadProxyList();
+            for (SharedConfig.ProxyInfo info : new ArrayList<>(SharedConfig.proxyList)) {
+                if (isXray(info)) {
+                    return true;
+                }
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+        return false;
+    }
+
+    public static boolean isBlocked() {
+        return !hasXrayEntries() && !isDirectAllowed();
+    }
+
+    /** True if deleting these entries leaves the list without XRAY entries (while it had some). */
+    public static boolean removesLastXray(Collection<SharedConfig.ProxyInfo> toDelete) {
+        boolean deletesXray = false;
+        for (SharedConfig.ProxyInfo info : toDelete) {
+            deletesXray |= isXray(info);
+        }
+        if (!deletesXray) {
+            return false;
+        }
+        for (SharedConfig.ProxyInfo info : new ArrayList<>(SharedConfig.proxyList)) {
+            if (isXray(info) && !toDelete.contains(info)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** FEAT-03 "Connect directly?" confirmation (red button); {@code proceed} runs on confirm. */
+    public static void confirmDirect(Activity activity, Runnable proceed) {
+        if (activity == null) {
+            return;
+        }
+        org.telegram.ui.ActionBar.AlertDialog dialog = new org.telegram.ui.ActionBar.AlertDialog.Builder(activity)
+                .setTitle(XrayTransport.str("Подключиться напрямую?", "Connect directly?"))
+                .setMessage(XrayTransport.str(
+                        "Xraygram подключится к Telegram без XRAY: провайдер увидит это соединение, а там, где Telegram блокируют, связи не будет. Вернуться к XRAY: Настройки → Данные и память → Прокси.",
+                        "Xraygram will connect to Telegram without XRAY: your provider will see this connection, and where Telegram is blocked it will not work. To go back to XRAY: Settings → Data and Storage → Proxy."))
+                .setPositiveButton(XrayTransport.str("Подключиться напрямую", "Connect directly"), (d, w) -> proceed.run())
+                .setNegativeButton(XrayTransport.str("Отмена", "Cancel"), null)
+                .create();
+        dialog.show();
+        android.view.View button = dialog.getButton(android.content.DialogInterface.BUTTON_POSITIVE);
+        if (button instanceof android.widget.TextView) {
+            org.telegram.ui.ActionBar.ThemeBind.textColor((android.widget.TextView) button, org.telegram.ui.ActionBar.Theme.key_text_RedBold);
+        }
+    }
+
+    public static String lastXrayDeleteTitle() {
+        return XrayTransport.str("Удалить последнюю XRAY-запись?", "Delete the last XRAY entry?");
+    }
+
+    public static String lastXrayDeleteText() {
+        return XrayTransport.str(
+                "Без неё Xraygram не будет подключаться к Telegram, пока вы не добавите ссылку или явно не выберете подключение напрямую. Ссылка останется в сохранённых серверах.",
+                "Without it Xraygram will not connect to Telegram until you add a link or explicitly choose a direct connection. The link stays in saved servers.");
+    }
+
+    /** Another XRAY entry to switch to when the active one is deleted, or null. */
+    public static SharedConfig.ProxyInfo nextXray(SharedConfig.ProxyInfo deleted) {
+        for (SharedConfig.ProxyInfo info : new ArrayList<>(SharedConfig.proxyList)) {
+            if (info != deleted && isXray(info)) {
+                return info;
+            }
+        }
+        return null;
+    }
+
+    // ------------------------------------------------------------------ saved links
+
+    /** Links of deleted XRAY entries (newest first), minus links that are in the list again. */
+    public static ArrayList<String> savedLinks() {
+        LinkedHashSet<String> result = new LinkedHashSet<>(readSaved());
+        for (SharedConfig.ProxyInfo info : new ArrayList<>(SharedConfig.proxyList)) {
+            if (isXray(info)) {
+                result.remove(info.settings.getSecret().trim());
+            }
+        }
+        return new ArrayList<>(result);
+    }
+
+    /** Called when an XRAY entry is deleted: keep its link for the gate screen. */
+    public static void rememberLink(String link) {
+        if (!XrayTransport.isSupportedLink(link)) {
+            return;
+        }
+        LinkedHashSet<String> links = new LinkedHashSet<>();
+        links.add(link.trim());
+        links.addAll(readSaved());
+        writeSaved(new ArrayList<>(links));
+    }
+
+    private static ArrayList<String> readSaved() {
+        ArrayList<String> links = new ArrayList<>();
+        try {
+            String json = prefs().getString(PREF_SAVED_LINKS, null);
+            if (!TextUtils.isEmpty(json)) {
+                JSONArray array = new JSONArray(json);
+                for (int i = 0; i < array.length(); i++) {
+                    String link = array.optString(i);
+                    if (XrayTransport.isSupportedLink(link)) {
+                        links.add(link.trim());
+                    }
+                }
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+        return links;
+    }
+
+    private static void writeSaved(ArrayList<String> links) {
+        JSONArray array = new JSONArray();
+        for (int i = 0; i < links.size() && i < 20; i++) {
+            array.put(links.get(i));
+        }
+        prefs().edit().putString(PREF_SAVED_LINKS, array.toString()).commit();
+    }
+
+    // ------------------------------------------------------------------ actions
+
+    /** "Connect": add (or reuse) the XRAY entry for this link, select it, enable the proxy. */
+    public static void connect(String link) {
+        link = link.trim();
+        final ProxySettings settings = ProxySettings.builder()
+                .setType(ProxySettings.Type.XRAY)
+                .setSecret(link)
+                .build();
+        if (!settings.isValid()) {
+            return;
+        }
+        final SharedConfig.ProxyInfo info = SharedConfig.addProxy(new SharedConfig.ProxyInfo(settings));
+        SharedConfig.currentProxy = info;
+        SharedPreferences.Editor editor = prefs().edit();
+        editor.putBoolean("proxy_enabled", true);
+        info.settings.toSharedPreferences(editor);
+        editor.putBoolean(PREF_DIRECT_ALLOWED, false);
+        editor.commit();
+        SharedConfig.saveProxyList();
+        ConnectionsManager.setProxySettings(true, info.settings);
+        NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.proxySettingsChanged);
+        XrayPush.onGateOpened(LaunchActivity.instance); // FEAT-09: FCM / background connection only now
+    }
+
+    /** "Connect without XRAY": explicit choice, then the usual proxy settings apply. */
+    public static void allowDirect() {
+        setDirectAllowed(true);
+        final boolean enabled = prefs().getBoolean("proxy_enabled", false) && SharedConfig.currentProxy != null;
+        ConnectionsManager.setProxySettings(enabled, enabled ? SharedConfig.currentProxy.settings : null);
+        NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.proxySettingsChanged);
+        XrayPush.onGateOpened(LaunchActivity.instance); // FEAT-09: FCM / background connection only now
+    }
+
+    /** Shows the gate on top of everything if blocked and it is not shown yet. */
+    public static void showIfNeeded(Activity activity) {
+        if (!(activity instanceof LaunchActivity) || !isBlocked()) {
+            return;
+        }
+        final LaunchActivity launchActivity = (LaunchActivity) activity;
+        if (launchActivity.getActionBarLayout() == null) {
+            return;
+        }
+        final BaseFragment last = launchActivity.getActionBarLayout().getLastFragment();
+        if (last instanceof XrayGateActivity) {
+            return;
+        }
+        launchActivity.presentFragment(new XrayGateActivity());
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayLinkPreview.java b/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayLinkPreview.java
new file mode 100644
index 000000000..a69ba611f
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayLinkPreview.java
@@ -0,0 +1,91 @@
+package org.telegram.utils.proxy;
+
+import android.text.TextUtils;
+
+import java.util.Locale;
+
+import static org.telegram.utils.proxy.XrayTransport.str;
+
+/**
+ * Xraygram: the line under the link field (FEAT-01): "Server: proto · host:port · name" or "Error: <friendly text>"
+ * from the table «Понятные ошибки». Android shows the Java parse at once; the core check then confirms or replaces it.
+ */
+public final class XrayLinkPreview {
+
+    private XrayLinkPreview() {
+    }
+
+    /** Hint under the field (macOS/Android text of FEAT-01). */
+    public static String hint() {
+        return str("Ссылка на ваш сервер: vless://, vmess://, trojan://, ss:// или hysteria2://. Если она скопирована, подставится сама.",
+                "Link to your server: vless://, vmess://, trojan://, ss:// or hysteria2://. If it is copied, it is filled in automatically.");
+    }
+
+    public static String fieldTitle() {
+        return str("Ссылка", "Link");
+    }
+
+    /** Instant check in Java. null = empty field. */
+    public static String instant(String link) {
+        link = link == null ? "" : link.trim();
+        if (link.isEmpty()) {
+            return null;
+        }
+        final String lower = link.toLowerCase(Locale.US);
+        if (lower.startsWith("http://") || lower.startsWith("https://")) {
+            return error(str("Это ссылка на сайт или подписку. Нужна ссылка на один сервер: vless://, vmess://, trojan://, ss:// или hysteria2://",
+                    "This is a web or subscription link. A single-server link is needed: vless://, vmess://, trojan://, ss:// or hysteria2://"));
+        }
+        if (!XrayTransport.isSupportedLink(link)) {
+            return error(notServerLink());
+        }
+        final XrayTransport.LinkInfo info = XrayTransport.parse(link);
+        if (!info.isValid()) {
+            return error(incomplete());
+        }
+        return str("Сервер: ", "Server: ") + info.describe();
+    }
+
+    /** Passes the instant check (Save / Connect may be enabled). */
+    public static boolean instantValid(String link) {
+        return link != null && XrayTransport.isSupportedLink(link) && XrayTransport.parse(link).isValid();
+    }
+
+    /** Core check (blocking, off the UI thread): null if xray accepts the link, else "Error: …". */
+    public static String coreVerdict(String link) {
+        final String core = XrayTransport.validate(link);
+        if (core == null) {
+            return null;
+        }
+        return error(friendly(core));
+    }
+
+    /** Maps libXray's error text to the FEAT-01 table. */
+    public static String friendly(String core) {
+        final String lower = core == null ? "" : core.toLowerCase(Locale.US);
+        if (lower.contains("unsupported share format")) {
+            return notServerLink();
+        }
+        if (lower.contains("no valid outbound")) {
+            return incomplete();
+        }
+        if (lower.contains("timeout") || lower.contains("deadline")) {
+            return str("Не удалось проверить ссылку. Попробуйте ещё раз", "Could not check the link. Try again");
+        }
+        return str("Ссылка не распознана", "Link not recognized") + (TextUtils.isEmpty(core) ? "" : " (" + core + ")");
+    }
+
+    private static String notServerLink() {
+        return str("Это не ссылка на сервер. Нужна ссылка vless://, vmess://, trojan://, ss:// или hysteria2://",
+                "This is not a server link. Use vless://, vmess://, trojan://, ss:// or hysteria2://");
+    }
+
+    private static String incomplete() {
+        return str("В ссылке не хватает данных (адрес, порт, ключ или параметры). Скопируйте её целиком ещё раз",
+                "The link is incomplete (address, port, key or parameters). Copy the whole link again");
+    }
+
+    private static String error(String text) {
+        return str("Ошибка: ", "Error: ") + text;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayPush.java b/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayPush.java
new file mode 100644
index 000000000..99f105695
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayPush.java
@@ -0,0 +1,232 @@
+package org.telegram.utils.proxy;
+
+import android.Manifest;
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.pm.PackageManager;
+import android.net.Uri;
+import android.os.Build;
+import android.os.PowerManager;
+import android.provider.Settings;
+import android.text.TextUtils;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.BuildConfig;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.SharedConfig;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.LaunchActivity;
+
+import static org.telegram.utils.proxy.XrayTransport.str;
+
+/**
+ * Xraygram: push notifications (FEAT-09, product/features/FEAT-09.md).
+ *
+ * Main path — FCM, only with Xraygram's own Firebase project: the build takes {@code .secrets/google-services.json}
+ * (package io.github.xraygram) and sets {@code BuildConfig.XRAYGRAM_FCM}. With the upstream Telegram file FCM is never
+ * started. Nothing touches Firebase while the XRAY gate is closed (FEAT-03). The token goes to Telegram the usual way,
+ * {@code account.registerDevice} over MTProto, i.e. through xray.
+ *
+ * Fallback — Keep-Alive Service + Background Connection: no own Firebase project, no Google Play services, no token
+ * within 60 s after the gate opened, or an FCM error. Once on, it stays on (the user can switch it off in settings).
+ */
+public final class XrayPush {
+
+    private static final String PREF_FALLBACK = "xraygram_push_fallback";
+    private static final String PREF_EXPLAINED = "xraygram_push_explained";
+    private static final long TOKEN_TIMEOUT_MS = 60_000;
+
+    private static boolean tokenWatchScheduled;
+
+    private XrayPush() {
+    }
+
+    private static SharedPreferences prefs() {
+        return MessagesController.getGlobalMainSettings();
+    }
+
+    /** Built with Xraygram's own google-services.json. */
+    public static boolean fcmBuilt() {
+        return BuildConfig.XRAYGRAM_FCM;
+    }
+
+    private static boolean hasPlayServices() {
+        try {
+            return ApplicationLoader.getPushProvider().hasServices();
+        } catch (Throwable e) {
+            return false;
+        }
+    }
+
+    /** The fallback (background connection) is the delivery path. */
+    public static boolean isFallback() {
+        try {
+            return !fcmBuilt() || !hasPlayServices() || prefs().getBoolean(PREF_FALLBACK, false);
+        } catch (Throwable e) {
+            return true;
+        }
+    }
+
+    /** FCM is (expected to be) delivering pushes. */
+    public static boolean fcmActive() {
+        return !isFallback();
+    }
+
+    /** Default for Keep-Alive Service / Background Connection when the user has not chosen. */
+    public static boolean keepAliveDefault(boolean serverValue) {
+        return isFallback() || serverValue;
+    }
+
+    // ------------------------------------------------------------------ lifecycle
+
+    /** The XRAY gate has just opened ("Connect" or explicit "direct"). UI thread. */
+    public static void onGateOpened(Activity activity) {
+        ApplicationLoader.initPushServicesIfReady();
+        requestNotificationPermission(activity);
+        if (isFallback()) {
+            applyFallback(activity);
+        } else {
+            watchToken();
+        }
+    }
+
+    /** App start with the gate already open: keep the 60 s token watch. */
+    public static void onAppStarted() {
+        if (!XrayGate.isBlocked() && fcmActive()) {
+            watchToken();
+        }
+    }
+
+    private static void watchToken() {
+        if (tokenWatchScheduled) {
+            return;
+        }
+        tokenWatchScheduled = true;
+        AndroidUtilities.runOnUIThread(() -> {
+            tokenWatchScheduled = false;
+            if (fcmActive() && TextUtils.isEmpty(SharedConfig.pushString)) {
+                FileLog.d("xraygram: no FCM token in 60 s, switching to background connection");
+                switchToFallback();
+            }
+        }, TOKEN_TIMEOUT_MS);
+    }
+
+    /** Called by PushListenerController when FCM failed to give a token. */
+    public static void onFcmFailed() {
+        AndroidUtilities.runOnUIThread(() -> {
+            if (fcmActive()) {
+                FileLog.d("xraygram: FCM failed, switching to background connection");
+                switchToFallback();
+            }
+        });
+    }
+
+    private static void switchToFallback() {
+        prefs().edit().putBoolean(PREF_FALLBACK, true).commit();
+        applyFallback(LaunchActivity.instance);
+    }
+
+    /** Turns on Keep-Alive / Background Connection (unless the user switched them off) and explains once. */
+    private static void applyFallback(Activity activity) {
+        try {
+            ApplicationLoader.startPushService();
+            for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+                if (UserConfig.getInstance(a).isClientActivated()) {
+                    ConnectionsManager connectionsManager = ConnectionsManager.getInstance(a);
+                    connectionsManager.setPushConnectionEnabled(connectionsManager.isPushConnectionEnabled());
+                }
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+        showExplanationIfNeeded(activity);
+    }
+
+    // ------------------------------------------------------------------ UI
+
+    public static boolean isIgnoringBatteryOptimizations() {
+        if (Build.VERSION.SDK_INT < 23) {
+            return true;
+        }
+        try {
+            PowerManager pm = (PowerManager) ApplicationLoader.applicationContext.getSystemService(Context.POWER_SERVICE);
+            return pm != null && pm.isIgnoringBatteryOptimizations(ApplicationLoader.applicationContext.getPackageName());
+        } catch (Throwable e) {
+            return false;
+        }
+    }
+
+    public static void requestIgnoreBatteryOptimizations(Activity activity) {
+        if (activity == null || Build.VERSION.SDK_INT < 23) {
+            return;
+        }
+        try {
+            Intent intent = new Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS);
+            intent.setData(Uri.parse("package:" + activity.getPackageName()));
+            activity.startActivity(intent);
+        } catch (Throwable e) {
+            try {
+                activity.startActivity(new Intent(Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS));
+            } catch (Throwable ignore) {
+            }
+        }
+    }
+
+    /** Android 13+: ask for notifications right after the gate opened (not earlier). */
+    private static void requestNotificationPermission(Activity activity) {
+        if (activity == null || Build.VERSION.SDK_INT < 33) {
+            return;
+        }
+        try {
+            if (activity.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
+                activity.requestPermissions(new String[]{Manifest.permission.POST_NOTIFICATIONS}, 1);
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+
+    /** One-time "Background notifications" explanation on the fallback path. */
+    public static void showExplanationIfNeeded(Activity activity) {
+        if (activity == null || activity.isFinishing() || XrayGate.isBlocked() || !isFallback()
+                || prefs().getBoolean(PREF_EXPLAINED, false) || isIgnoringBatteryOptimizations()) {
+            return;
+        }
+        prefs().edit().putBoolean(PREF_EXPLAINED, true).commit();
+        try {
+            new AlertDialog.Builder(activity)
+                    .setTitle(str("Уведомления в фоне", "Background notifications"))
+                    .setMessage(str(
+                            "На этом телефоне нет сервисов Google для уведомлений. Xraygram будет получать сообщения сам, через ваш сервер XRAY. Чтобы уведомления приходили, когда приложение закрыто, разрешите ему работать в фоне.",
+                            "This phone has no Google notification services. Xraygram will receive messages itself, through your XRAY server. To get notifications while the app is closed, allow it to run in the background."))
+                    .setPositiveButton(str("Разрешить", "Allow"), (d, w) -> requestIgnoreBatteryOptimizations(activity))
+                    .setNegativeButton(str("Не сейчас", "Not now"), null)
+                    .show();
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+
+    /** Status line for Settings → Notifications and Sounds. */
+    public static String statusText() {
+        if (fcmActive()) {
+            return str("Уведомления: через Google (FCM)", "Notifications: via Google (FCM)");
+        }
+        if (isIgnoringBatteryOptimizations()) {
+            return str("Уведомления: фоновое соединение", "Notifications: background connection");
+        }
+        return str("Уведомления: фоновое соединение, работа в фоне ограничена",
+                "Notifications: background connection, background activity restricted");
+    }
+
+    /** Text of the persistent notification of the keep-alive service. */
+    public static String keepAliveNotificationText() {
+        return str("Xraygram на связи", "Xraygram is connected");
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayTransport.java b/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayTransport.java
new file mode 100644
index 000000000..08c75ccd3
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/utils/proxy/XrayTransport.java
@@ -0,0 +1,449 @@
+package org.telegram.utils.proxy;
+
+import android.net.Uri;
+import android.text.TextUtils;
+import android.util.Base64;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.SharedConfig;
+
+import java.net.InetAddress;
+import java.net.ServerSocket;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.Locale;
+import java.util.Set;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+import libXray.LibXray;
+
+/**
+ * Xraygram: in-process Xray-core (libXray, gomobile) for proxy entries of type
+ * {@link ProxySettings.Type#XRAY}. Telegram's network code (tgnet) sees each
+ * XRAY entry as an ordinary SOCKS5 proxy on 127.0.0.1.
+ *
+ * libXray can only run one Xray instance per process, so a single instance
+ * serves all XRAY entries at once: one password-protected SOCKS5 inbound per
+ * share link, routed to that link's outbound. Every link keeps its local port
+ * for the life of the process, so restarting Xray (when a new link appears)
+ * never changes what tgnet is connected to.
+ */
+public final class XrayTransport {
+
+    public static final String SOCKS_USER = "xraygram";
+
+    private static final int API_VERSION = 3;
+    private static final Object lock = new Object();
+    private static final ExecutorService executor = Executors.newSingleThreadExecutor(r -> {
+        Thread thread = new Thread(r, "xraygram-core");
+        thread.setDaemon(true);
+        return thread;
+    });
+
+    private static final String socksPassword = randomHex(16);
+    private static final HashMap<String, Integer> ports = new HashMap<>();
+    private static final Set<String> runningLinks = new LinkedHashSet<>();
+    /** link → user-facing reason why its core is not serving (FEAT-02 "XRAY: <reason>"). */
+    private static final HashMap<String, String> linkErrors = new HashMap<>();
+    private static boolean running;
+    private static String lastError;
+
+    private XrayTransport() {
+    }
+
+    public static String getSocksPassword() {
+        return socksPassword;
+    }
+
+    public static boolean isSupportedLink(String link) {
+        if (TextUtils.isEmpty(link)) {
+            return false;
+        }
+        String lower = link.trim().toLowerCase(Locale.US);
+        return lower.startsWith("vless://")
+                || lower.startsWith("vmess://")
+                || lower.startsWith("trojan://")
+                || lower.startsWith("ss://")
+                || lower.startsWith("hysteria2://")
+                || lower.startsWith("hy2://");
+    }
+
+    /**
+     * Returns the local SOCKS5 port reserved for this link (or 0 if the link is
+     * not supported) and starts Xray in the background if it is not already
+     * serving the link. tgnet keeps retrying until the inbound is up.
+     */
+    public static int startAsync(String link) {
+        final int port = portFor(link);
+        if (port != 0) {
+            executor.execute(() -> ensureRunning(link));
+        }
+        return port;
+    }
+
+    /** Stops Xray in the background (no XRAY entry is in use). */
+    public static void stopAsync() {
+        executor.execute(() -> {
+            synchronized (lock) {
+                stopInternal();
+            }
+        });
+    }
+
+    /**
+     * Makes sure Xray serves this link, then calls back on the Xray thread with
+     * the local port, or 0 on failure. Used by proxy checks.
+     */
+    public static void withRunning(String link, PortCallback callback) {
+        executor.execute(() -> callback.run(ensureRunning(link) ? portFor(link) : 0));
+    }
+
+    public interface PortCallback {
+        void run(int port);
+    }
+
+    /** Reason for "XRAY: <reason>" in the proxy list, or null if the core is fine (or not tried yet). */
+    public static String statusError(String link) {
+        if (link == null) {
+            return null;
+        }
+        synchronized (lock) {
+            return linkErrors.get(link.trim());
+        }
+    }
+
+    /**
+     * After an XRAY entry was deleted: drop its link from the running core (FEAT-02 п. 7). Restarts xray with the
+     * remaining entries (ports stay the same), or stops it if none is left.
+     */
+    public static void pruneAsync() {
+        executor.execute(() -> {
+            synchronized (lock) {
+                if (!running) {
+                    return;
+                }
+                final ArrayList<String> known = knownLinks();
+                if (known.containsAll(runningLinks)) {
+                    return;
+                }
+                for (String link : new ArrayList<>(runningLinks)) {
+                    if (!known.contains(link)) {
+                        ports.remove(link);
+                        linkErrors.remove(link);
+                    }
+                }
+                stopInternal();
+                if (!known.isEmpty()) {
+                    ensureRunning(known.get(0));
+                }
+            }
+        });
+    }
+
+    public static String getLastError() {
+        synchronized (lock) {
+            return lastError;
+        }
+    }
+
+    public static String version() {
+        try {
+            JSONObject data = invoke("xrayVersion", null).optJSONObject("data");
+            return data != null ? data.optString("version") : "";
+        } catch (Throwable e) {
+            return "";
+        }
+    }
+
+    // ------------------------------------------------------------------ link info
+
+    /** What a share link points to; parsed in Java, never throws. */
+    public static final class LinkInfo {
+        public String protocol = "";
+        public String host = "";
+        public int port;
+        public String name = "";
+
+        public boolean isValid() {
+            return !TextUtils.isEmpty(host);
+        }
+
+        /** "name" from #fragment, else the server address. */
+        public String displayName() {
+            return !TextUtils.isEmpty(name) ? name : host;
+        }
+
+        /** "vless · host:port · name" */
+        public String describe() {
+            StringBuilder sb = new StringBuilder(protocol);
+            sb.append(" · ").append(host);
+            if (port > 0) {
+                sb.append(':').append(port);
+            }
+            if (!TextUtils.isEmpty(name)) {
+                sb.append(" · ").append(name);
+            }
+            return sb.toString();
+        }
+    }
+
+    public static LinkInfo parse(String link) {
+        LinkInfo info = new LinkInfo();
+        if (!isSupportedLink(link)) {
+            return info;
+        }
+        try {
+            String trimmed = link.trim();
+            int colon = trimmed.indexOf("://");
+            info.protocol = trimmed.substring(0, colon).toLowerCase(Locale.US);
+            if (info.protocol.equals("hy2")) {
+                info.protocol = "hysteria2";
+            }
+            if (info.protocol.equals("vmess")) {
+                String body = trimmed.substring(colon + 3);
+                int hash = body.indexOf('#');
+                if (hash >= 0) {
+                    info.name = Uri.decode(body.substring(hash + 1));
+                    body = body.substring(0, hash);
+                }
+                JSONObject json = new JSONObject(new String(Base64.decode(body, Base64.DEFAULT), StandardCharsets.UTF_8));
+                info.host = json.optString("add", "");
+                info.port = json.optInt("port", 0);
+                if (TextUtils.isEmpty(info.name)) {
+                    info.name = json.optString("ps", "");
+                }
+            } else {
+                Uri uri = Uri.parse(trimmed);
+                info.host = uri.getHost() != null ? uri.getHost() : "";
+                info.port = Math.max(uri.getPort(), 0);
+                String fragment = uri.getFragment();
+                info.name = fragment != null ? fragment.trim() : "";
+            }
+        } catch (Throwable ignore) {
+        }
+        return info;
+    }
+
+    /**
+     * Full check with Xray's own parser (blocking, call off the UI thread).
+     * Returns null if Xray accepts the link, otherwise the error text.
+     */
+    public static String validate(String link) {
+        try {
+            buildOutbound(link, "check");
+            return null;
+        } catch (Throwable e) {
+            String message = e.getMessage();
+            return !TextUtils.isEmpty(message) ? message : e.getClass().getSimpleName();
+        }
+    }
+
+    // ------------------------------------------------------------------ core
+
+    private static int portFor(String link) {
+        if (!isSupportedLink(link)) {
+            return 0;
+        }
+        link = link.trim();
+        synchronized (lock) {
+            Integer port = ports.get(link);
+            if (port == null) {
+                try {
+                    port = findFreePort();
+                } catch (Throwable e) {
+                    FileLog.e(e);
+                    linkErrors.put(link, str("нет свободного локального порта", "no free local port"));
+                    return 0;
+                }
+                ports.put(link, port);
+            }
+            return port;
+        }
+    }
+
+    /** Blocking. Restarts Xray with every known XRAY link if this one is not served yet. */
+    private static boolean ensureRunning(String link) {
+        if (!isSupportedLink(link)) {
+            return false;
+        }
+        link = link.trim();
+        synchronized (lock) {
+            if (running && runningLinks.contains(link) && isRunning()) {
+                return true;
+            }
+            LinkedHashSet<String> wanted = new LinkedHashSet<>();
+            wanted.add(link);
+            wanted.addAll(knownLinks());
+            try {
+                JSONArray inbounds = new JSONArray();
+                JSONArray outbounds = new JSONArray();
+                JSONArray rules = new JSONArray();
+                ArrayList<String> served = new ArrayList<>();
+                int index = 0;
+                for (String item : wanted) {
+                    JSONObject outbound;
+                    try {
+                        outbound = buildOutbound(item, "out-" + index);
+                    } catch (Throwable e) {
+                        if (item.equals(link)) {
+                            throw e;
+                        }
+                        FileLog.e("xraygram: skip broken link: " + e.getMessage());
+                        continue;
+                    }
+                    int port = portFor(item);
+                    inbounds.put(buildInbound("in-" + index, port));
+                    outbounds.put(outbound);
+                    rules.put(new JSONObject()
+                            .put("type", "field")
+                            .put("inboundTag", new JSONArray().put("in-" + index))
+                            .put("outboundTag", "out-" + index));
+                    served.add(item);
+                    index++;
+                }
+                JSONObject config = new JSONObject()
+                        .put("log", new JSONObject().put("loglevel", "warning"))
+                        .put("inbounds", inbounds)
+                        .put("outbounds", outbounds)
+                        .put("routing", new JSONObject()
+                                .put("domainStrategy", "AsIs")
+                                .put("rules", rules));
+
+                stopInternal();
+                JSONObject response = invoke("runXray", new JSONObject().put("xrayJson", config.toString()));
+                if (!response.optBoolean("success")) {
+                    throw new IllegalStateException(response.optString("error", "runXray failed"));
+                }
+                running = true;
+                runningLinks.addAll(served);
+                lastError = null;
+                linkErrors.clear();
+                FileLog.d("xraygram: xray " + version() + " serves " + served.size() + " link(s)");
+                return true;
+            } catch (Throwable e) {
+                lastError = e.getMessage();
+                linkErrors.put(link, str("не удалось запустить", "failed to start"));
+                FileLog.e("xraygram: start failed: " + e.getMessage());
+                return false;
+            }
+        }
+    }
+
+    /** Share links of all XRAY entries in the proxy list. */
+    private static ArrayList<String> knownLinks() {
+        ArrayList<String> links = new ArrayList<>();
+        try {
+            ArrayList<SharedConfig.ProxyInfo> list = new ArrayList<>(SharedConfig.proxyList);
+            for (SharedConfig.ProxyInfo info : list) {
+                if (info != null && info.settings.getType() == ProxySettings.Type.XRAY) {
+                    links.add(info.settings.getSecret().trim());
+                }
+            }
+            SharedConfig.ProxyInfo current = SharedConfig.currentProxy;
+            if (current != null && current.settings.getType() == ProxySettings.Type.XRAY) {
+                links.add(current.settings.getSecret().trim());
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+        return links;
+    }
+
+    private static JSONObject buildInbound(String tag, int port) throws Exception {
+        return new JSONObject()
+                .put("tag", tag)
+                .put("listen", "127.0.0.1")
+                .put("port", port)
+                .put("protocol", "socks")
+                .put("settings", new JSONObject()
+                        .put("auth", "password")
+                        .put("accounts", new JSONArray().put(new JSONObject()
+                                .put("user", SOCKS_USER)
+                                .put("pass", socksPassword)))
+                        .put("udp", false));
+    }
+
+    private static JSONObject buildOutbound(String link, String tag) throws Exception {
+        JSONObject converted = invoke("convertShareLinksToXrayJson", new JSONObject().put("text", link.trim()));
+        if (!converted.optBoolean("success")) {
+            throw new IllegalArgumentException(converted.optString("error", "bad link"));
+        }
+        Object data = converted.opt("data");
+        JSONObject doc = data instanceof JSONObject ? (JSONObject) data : new JSONObject(String.valueOf(data));
+        JSONArray outbounds = doc.optJSONArray("outbounds");
+        if (outbounds == null || outbounds.length() == 0) {
+            throw new IllegalArgumentException("no outbound in link");
+        }
+        JSONObject outbound = outbounds.getJSONObject(0);
+        outbound.put("tag", tag);
+        return outbound;
+    }
+
+    private static boolean isRunning() {
+        try {
+            JSONObject data = invoke("getXrayState", null).optJSONObject("data");
+            return data != null && data.optBoolean("running");
+        } catch (Throwable e) {
+            return false;
+        }
+    }
+
+    private static void stopInternal() {
+        if (running) {
+            try {
+                invoke("stopXray", null);
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+        }
+        running = false;
+        runningLinks.clear();
+    }
+
+    private static int findFreePort() throws Exception {
+        try (ServerSocket socket = new ServerSocket(0, 1, InetAddress.getByName("127.0.0.1"))) {
+            return socket.getLocalPort();
+        }
+    }
+
+    private static String randomHex(int bytes) {
+        byte[] data = new byte[bytes];
+        new SecureRandom().nextBytes(data);
+        StringBuilder sb = new StringBuilder(bytes * 2);
+        for (byte b : data) {
+            sb.append(String.format(Locale.US, "%02x", b & 0xff));
+        }
+        return sb.toString();
+    }
+
+    private static JSONObject invoke(String method, JSONObject payload) throws Exception {
+        JSONObject request = new JSONObject()
+                .put("apiVersion", API_VERSION)
+                .put("method", method);
+        if (payload != null) {
+            request.put("payload", payload);
+        }
+        return new JSONObject(LibXray.invoke(request.toString()));
+    }
+
+    // ------------------------------------------------------------------ strings
+
+    /** UI strings: Russian for ru locales, English otherwise (no strings.xml changes). */
+    public static String str(String ru, String en) {
+        String lang;
+        try {
+            LocaleController.LocaleInfo info = LocaleController.getInstance().getCurrentLocaleInfo();
+            lang = info != null ? info.getLangCode() : Locale.getDefault().getLanguage();
+        } catch (Throwable e) {
+            lang = Locale.getDefault().getLanguage();
+        }
+        return lang != null && lang.toLowerCase(Locale.US).startsWith("ru") ? ru : en;
+    }
+}
