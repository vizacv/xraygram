+    private void select(int index) {
+        selected = index;
+        for (int i = 0; i < choiceCells.size(); i++) {
+            final int cellIndex = i < savedLinks.size() ? i : -1;
+            choiceCells.get(i).setChecked(cellIndex == selected, true);
+        }
+        update();
+        if (selected == -1 && linkField.length() == 0) {
+            linkField.requestFocus();
+            AndroidUtilities.showKeyboard(linkField);
+        } else {
+            AndroidUtilities.hideKeyboard(linkField);
+        }
+    }
+
+    private String currentLink() {
+        if (selected >= 0 && selected < savedLinks.size()) {
+            return savedLinks.get(selected);
+        }
+        return linkField != null ? linkField.getText().toString().trim() : "";
+    }
+
+    private void update() {
+        if (linkContainer == null) {
+            return;
+        }
+        linkContainer.setVisibility(selected == -1 ? View.VISIBLE : View.GONE);
+        final String link = currentLink();
+        final boolean valid = org.telegram.utils.proxy.XrayLinkPreview.instantValid(link) && !link.equals(rejectedLink);
+        connectButton.setEnabled(valid);
+        connectButton.setAlpha(valid ? 1f : 0.5f);
+
+        final int generation = ++previewGeneration;
+        if (previewRunnable != null) {
+            AndroidUtilities.cancelRunOnUIThread(previewRunnable);
+            previewRunnable = null;
+        }
+        final String hint = org.telegram.utils.proxy.XrayLinkPreview.hint();
+        final String instant = org.telegram.utils.proxy.XrayLinkPreview.instant(link);
+        if (instant == null) {
+            previewCell.setText(hint);
+            return;
+        }
+        previewCell.setText(selected == -1 ? instant + "\n\n" + hint : instant);
+        if (!valid) {
+            return;
+        }
+        previewRunnable = () -> {
+            previewRunnable = null;
+            Utilities.globalQueue.postRunnable(() -> {
+                final String verdict = org.telegram.utils.proxy.XrayLinkPreview.coreVerdict(link);
+                AndroidUtilities.runOnUIThread(() -> {
+                    if (generation != previewGeneration || previewCell == null || verdict == null) {
+                        return;
+                    }
+                    rejectedLink = link; // FEAT-01 п. 6: xray rejected it — no entry from this link
+                    connectButton.setEnabled(false);
+                    connectButton.setAlpha(0.5f);
+                    previewCell.setText(selected == -1 ? verdict + "\n\n" + hint : verdict);
+                });
+            });
+        };
+        AndroidUtilities.runOnUIThread(previewRunnable, 300);
+    }
+
+    private void connect() {
+        final String link = currentLink();
+        if (!org.telegram.utils.proxy.XrayLinkPreview.instantValid(link) || link.equals(rejectedLink)) {
+            return;
+        }
+        AndroidUtilities.hideKeyboard(linkField);
+        XrayGate.connect(link);
+        if (!XrayGate.isBlocked()) {
+            finishFragment();
+        }
+    }
+
+    private void confirmDirect() {
+        XrayGate.confirmDirect(getParentActivity(), () -> {
+            XrayGate.allowDirect();
+            finishFragment();
+        });
+    }
+
+    private static String clipboardLink(Context context) {
+        try {
+            ClipboardManager clipboard = (ClipboardManager) context.getSystemService(Context.CLIPBOARD_SERVICE);
+            ClipData clip = clipboard != null ? clipboard.getPrimaryClip() : null;
+            if (clip != null && clip.getItemCount() > 0) {
+                CharSequence text = clip.getItemAt(0).coerceToText(context);
+                String link = text != null ? text.toString().trim() : null;
+                if (!TextUtils.isEmpty(link) && XrayTransport.isSupportedLink(link) && XrayTransport.parse(link).isValid()) {
+                    return link;
+                }
+            }
+        } catch (Throwable ignore) {
+        }
+        return null;
+    }
+}
