+
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        scrollView.addView(layout, new ScrollView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        TextView title = new TextView(context);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22);
+        title.setTypeface(AndroidUtilities.bold());
+        ThemeBind.textColor(title, Theme.key_windowBackgroundWhiteBlackText);
+        title.setText(str("Подключение через XRAY", "Connect through XRAY"));
+        layout.addView(title, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 21, 20, 21, 0));
+
+        TextView subtitle = new TextView(context);
+        subtitle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15);
+        ThemeBind.textColor(subtitle, Theme.key_windowBackgroundWhiteGrayText);
+        layout.addView(subtitle, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 21, 8, 21, 8));
+
+        // Saved servers (links of deleted XRAY entries) + "New link"
+        savedLinks = XrayGate.savedLinks();
+        subtitle.setText(savedLinks.isEmpty()
+                ? str("Xraygram подключается к Telegram только через ваш сервер XRAY. Вставьте ссылку на него: vless://, vmess://, trojan://, ss:// или hysteria2://. Пока ссылки нет, Xraygram никуда не подключается.",
+                      "Xraygram connects to Telegram only through your XRAY server. Paste its link: vless://, vmess://, trojan://, ss:// or hysteria2://. Until there is a link, Xraygram does not connect anywhere.")
+                : str("Xraygram подключается к Telegram только через ваш сервер XRAY. Выберите сохранённый сервер или вставьте новую ссылку. До этого Xraygram никуда не подключается.",
+                      "Xraygram connects to Telegram only through your XRAY server. Choose a saved server or paste a new link. Until then Xraygram does not connect anywhere."));
+        final String clip = clipboardLink(context);
+        if (!savedLinks.isEmpty()) {
+            HeaderCell header = new HeaderCell(context);
+            header.setText(str("Сохранённые серверы", "Saved servers"));
+            layout.addView(header);
+            selected = clip != null && !savedLinks.contains(clip) ? -1 : 0;
+            for (int i = 0; i <= savedLinks.size(); i++) {
+                final int index = i < savedLinks.size() ? i : -1;
+                RadioCell cell = new RadioCell(context);
+                ThemeBind.selectorBackground(cell, Theme.getSelectorDrawable(true), ThemeBind.of(Theme.key_windowBackgroundWhite), ThemeBind.of(Theme.key_listSelector));
+                String text = index >= 0
+                        ? "XRAY · " + XrayTransport.parse(savedLinks.get(index)).displayName()
+                        : str("Новая ссылка", "New link");
+                cell.setText(text, index == selected, i < savedLinks.size());
+                cell.setOnClickListener(v -> select(index));
