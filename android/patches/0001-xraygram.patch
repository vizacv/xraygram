+        linkField.setBackground(null);
+        ThemeBind.cursorColor(linkField, Theme.key_windowBackgroundWhiteBlackText);
+        linkField.setCursorSize(AndroidUtilities.dp(20));
+        linkField.setCursorWidth(1.5f);
+        linkField.setSingleLine(true);
+        linkField.setGravity((LocaleController.isRTL ? Gravity.RIGHT : Gravity.LEFT) | Gravity.CENTER_VERTICAL);
+        ThemeBind.editHeaderHintColor(linkField, Theme.key_windowBackgroundWhiteBlueHeader);
+        linkField.setTransformHintToHeader(true);
+        ThemeBind.lineColors(linkField, Theme.key_windowBackgroundWhiteInputField, Theme.key_windowBackgroundWhiteInputFieldActivated, Theme.key_text_RedRegular);
+        linkField.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS | InputType.TYPE_TEXT_VARIATION_URI);
+        linkField.setImeOptions(EditorInfo.IME_ACTION_DONE | EditorInfo.IME_FLAG_NO_EXTRACT_UI);
+        linkField.setHintText(org.telegram.utils.proxy.XrayLinkPreview.fieldTitle());
+        linkField.setPadding(0, 0, 0, 0);
