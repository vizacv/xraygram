+                .setPositiveButton(str("Показать", "Show"), (d, w) -> showSheet(activity, trimmed))
+                .setNegativeButton(str("Отмена", "Cancel"), null)
+                .show();
+    }
+
+    private static void showSheet(Activity activity, String link) {
+        final Context context = activity;
+        final BottomSheet.Builder builder = new BottomSheet.Builder(context);
+        builder.setApplyTopPadding(false);
+        builder.setApplyBottomPadding(false);
+
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setPadding(0, AndroidUtilities.dp(18), 0, AndroidUtilities.dp(12));
+
+        TextView title = new TextView(context);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20);
+        title.setTypeface(AndroidUtilities.bold());
+        title.setGravity(Gravity.CENTER_HORIZONTAL);
+        ThemeBind.textColor(title, Theme.key_dialogTextBlack);
+        title.setText("XRAY · " + XrayTransport.parse(link).displayName());
+        layout.addView(title, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 22, 0, 22, 14));
+
+        ImageView qr = new ImageView(context);
+        qr.setBackgroundColor(Color.WHITE);
+        qr.setPadding(AndroidUtilities.dp(10), AndroidUtilities.dp(10), AndroidUtilities.dp(10), AndroidUtilities.dp(10));
+        qr.setScaleType(ImageView.ScaleType.FIT_CENTER);
+        qr.setImageBitmap(createQR(link));
+        FrameLayout qrFrame = new FrameLayout(context);
+        qrFrame.addView(qr, LayoutHelper.createFrame(260, 260, Gravity.CENTER));
+        layout.addView(qrFrame, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 260));
+
+        TextView help = new TextView(context);
+        help.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14);
+        help.setGravity(Gravity.CENTER_HORIZONTAL);
+        ThemeBind.textColor(help, Theme.key_dialogTextGray3);
+        help.setText(str("Отсканируйте камерой телефона, затем вставьте ссылку в Xraygram",
+                "Scan with a phone camera, then paste the link into Xraygram"));
+        layout.addView(help, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 40, 12, 40, 12));
+
+        final BottomSheet[] sheet = new BottomSheet[1];
+
+        ButtonWithCounterView copy = new ButtonWithCounterView(context, null).setRound();
+        copy.setText(str("Копировать ссылку", "Copy link"), false);
+        copy.setOnClickListener(v -> copyLink(context, link));
+        layout.addView(copy, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 48, 16, 4, 16, 4));
+
+        ButtonWithCounterView send = new ButtonWithCounterView(context, false, null).setRound();
+        send.setText(str("Отправить…", "Send…"), false);
+        send.setOnClickListener(v -> {
+            Intent shareIntent = new Intent(Intent.ACTION_SEND);
+            shareIntent.setType("text/plain");
+            shareIntent.putExtra(Intent.EXTRA_TEXT, link);
+            try {
+                activity.startActivity(Intent.createChooser(shareIntent, str("Отправить…", "Send…")));
+            } catch (Throwable e) {
+                FileLog.e("xraygram: share chooser failed");
+            }
+        });
+        layout.addView(send, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 48, 16, 4, 16, 4));
+
+        ButtonWithCounterView close = new ButtonWithCounterView(context, false, null).setRound();
+        close.setText(str("Закрыть", "Close"), false);
+        close.setOnClickListener(v -> {
+            if (sheet[0] != null) {
+                sheet[0].dismiss();
+            }
+        });
+        layout.addView(close, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 48, 16, 4, 16, 4));
+
+        builder.setCustomView(layout);
+        sheet[0] = builder.create();
+        sheet[0].show();
+    }
+
+    private static void copyLink(Context context, String link) {
+        try {
+            ClipboardManager clipboard = (ClipboardManager) context.getSystemService(Context.CLIPBOARD_SERVICE);
+            ClipData clip = ClipData.newPlainText("XRAY", link);
+            if (Build.VERSION.SDK_INT >= 33) {
+                PersistableBundle extras = new PersistableBundle();
+                extras.putBoolean(ClipDescription.EXTRA_IS_SENSITIVE, true);
+                clip.getDescription().setExtras(extras);
+            }
+            clipboard.setPrimaryClip(clip);
+            Toast.makeText(context, str("Ссылка скопирована", "Link copied"), Toast.LENGTH_SHORT).show();
+        } catch (Throwable e) {
+            FileLog.e("xraygram: copy failed");
+        }
+    }
+
+    /** Plain QR (no Telegram logo in the middle, unlike TelegramQRCodeWriter). */
+    private static Bitmap createQR(String link) {
+        try {
+            HashMap<EncodeHintType, Object> hints = new HashMap<>();
+            hints.put(EncodeHintType.ERROR_CORRECTION, ErrorCorrectionLevel.M);
+            hints.put(EncodeHintType.MARGIN, 0);
+            hints.put(EncodeHintType.CHARACTER_SET, "UTF-8");
+            com.google.zxing.common.BitMatrix matrix = new com.google.zxing.qrcode.QRCodeWriter()
+                    .encode(link, com.google.zxing.BarcodeFormat.QR_CODE, 0, 0, hints);
+            final int w = matrix.getWidth(), h = matrix.getHeight(), scale = Math.max(1, 768 / Math.max(w, 1));
+            final int[] pixels = new int[w * scale * h * scale];
+            for (int y = 0; y < h * scale; y++) {
+                for (int x = 0; x < w * scale; x++) {
+                    pixels[y * w * scale + x] = matrix.get(x / scale, y / scale) ? Color.BLACK : Color.WHITE;
+                }
+            }
+            return Bitmap.createBitmap(pixels, w * scale, h * scale, Bitmap.Config.ARGB_8888);
+        } catch (Throwable e) {
+            FileLog.e("xraygram: QR failed");
+            return null;
+        }
+    }
+}
