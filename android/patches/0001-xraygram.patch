+/**
+ * Xraygram (FEAT-15, stage 1): "Share server" for an XRAY entry. A warning every time, then QR of the stored link
+ * (with #name) without the link as text, "Copy link" (sensitive clip on Android 13+), "Send…", "Close".
+ * The link is never logged.
+ */
+public final class XrayShareSheet {
+
+    private XrayShareSheet() {
+    }
+
+    public static String actionTitle() {
+        return str("Поделиться сервером", "Share server");
+    }
+
+    /** Warning → sheet. */
+    public static void show(Activity activity, String link) {
+        if (activity == null || !XrayTransport.isSupportedLink(link)) {
+            return;
+        }
+        final String trimmed = link.trim();
+        new AlertDialog.Builder(activity)
+                .setTitle(str("Поделиться сервером?", "Share server?"))
+                .setMessage(str("Кто получит эту ссылку, сможет пользоваться вашим сервером XRAY. Отправляйте её только тем, кому доверяете.",
